  if (!paths[name]) return ({warn:'!'}[name] || '•');
  return `<svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">${paths[name]}</svg>`;
};

function uiHint(label,description,glyph='info'){
  return `<button type="button" class="ui-hint" data-help data-tooltip="${esc(description)}" aria-label="${esc(label)}">${icon(glyph)}</button>`;
}
function uiAction(glyph,label,action,data={},disabled=false){
  const attrs=Object.entries(data).map(([name,value])=>`data-${name}="${esc(value)}"`).join(' ');
  return `<button type="button" class="btn small ui-action" data-action="${esc(action)}" ${attrs} aria-label="${esc(label)}" data-tooltip="${esc(label)}" ${disabled?'disabled aria-busy="true"':''}>${icon(glyph)}<span class="ui-action-label">${esc(label)}</span></button>`;
}

const resourceHash = (section,id) => `#/${section}/${encodeURIComponent(String(id ?? ''))}`;
function currentRoute() {
  const raw = location.hash.split('?')[0].replace(/^#\/?/, '') || 'overview';
  const parts = raw.split('/').filter(Boolean);
  let id = parts.length > 1 ? parts.slice(1).join('/') : null;
  if(id){try{id=decodeURIComponent(id)}catch{}}
  return { raw, section: parts[0] || 'overview', id };
}

async function boot() {
  const generation=state.bootGeneration=(state.bootGeneration||0)+1;
  clearCodexUsageResetState();state.detailLoads?.clear();
  state.analyticsCache.clear(); state.analyticsTo=new Date().toISOString(); restoreConsoleLocation();
  providerQuotaView=''; invalidateProviderCodexUsage(); state.providerCache.clear(); state.modelCache.clear();
  state.loading = true; state.error = null; state.partialErrors = [];
  try {
    const auth=await adapter.getAuthStatus();if(generation!==state.bootGeneration)return;state.auth=auth;
  } catch (error) {
    if(generation!==state.bootGeneration)return;state.loading = false; state.error = error; render(); return;
  }
  if (!state.auth.initialized || !state.auth.authenticated) {
    state.loading = false; render(); return;
  }
  const entries = [
    ['overview', adapter.getOverview(state.overviewWindow)], ['models', adapter.getModels(state.overviewWindow)], ['providers', adapter.getProviders()],
    ['requests', adapter.getRequests(requestFilters())], ['apiKeys', adapter.getApiKeys(state.keyWindow)],
    ['revisions', adapter.getRevisions()], ['billing', adapter.getBilling(state.billingWindow)], ['securityEvents', adapter.getSecurityEvents()],
    ['managementTokens', adapter.getManagementTokens()],
    ['alertEnvelope', adapter.getAlerts()], ['settings', adapter.getSettings()],
  ];
  state.overview ||= emptyOverview(); state.models ||= []; state.providers ||= []; state.requests = [];
  state.apiKeys ||= []; state.revisions ||= []; state.securityEvents ||= []; state.managementTokens ||= [];
  state.billing ||= {totalCost:'—',totalRequests:'—',totalTokens:'—',avgCost:'—',providers:[],models:[]};
  state.requestLoading=true;
  const initialRequestScope=JSON.stringify(requestFilters()),route=currentRoute(),critical=new Set(['models','providers','apiKeys','settings']);
  if(route.section==='overview')critical.add('overview');if(route.section==='requests')critical.add('requests');
  if(route.section==='settings'&&route.id==='security'){critical.add('managementTokens');critical.add('securityEvents')}
  if(route.section==='settings'&&route.id==='revisions')critical.add('revisions');
  let successes=0;
  const work=entries.map(([key,promise])=>Promise.resolve(promise).then(value=>{
    if(generation!==state.bootGeneration||!state.auth?.authenticated)return;
    if(key==='requests'&&initialRequestScope!==JSON.stringify(requestFilters()))return;
    state[key]=value;successes++;
    if(key==='requests'){state.requestTotal=Number(value.total??value.length);state.requestLastUpdated=new Date();state.requestQueryKey=initialRequestScope;state.requestError=null;state.requestLoading=false}
    if(key==='alertEnvelope'){state.alerts=value.alerts||[];state.alertUnread=Number(value.unread||0)}
  },error=>{if(generation!==state.bootGeneration||!state.auth?.authenticated)return;state.partialErrors.push({key,error});if(key==='requests'&&initialRequestScope===JSON.stringify(requestFilters())){state.requestLoading=false;state.requestError={message:error.message,stale:false}}}));
  await Promise.allSettled(work.filter((_,index)=>critical.has(entries[index][0])));
  if(generation!==state.bootGeneration||!state.auth?.authenticated)return;
  state.loading=false;render();
  await Promise.allSettled(work);
  if(generation!==state.bootGeneration||!state.auth?.authenticated)return;
  if(!successes)state.error=state.partialErrors[0]?.error||new Error('Every console API failed.');
  // Completing a background audit/security read must not replace an open editor.
  if(!state.modal&&!state.drawer&&!document.activeElement?.matches?.('input,select,textarea'))render();

}

async function changeUsageWindow(kind, window) {
  if (state.usageLoading[kind]) return;
  state.usageLoading[kind] = true;
  render();
  try {
    if (kind === 'overview') {
      const [overview, models] = await Promise.all([adapter.getOverview(window), adapter.getModels(window)]);
      Object.assign(state, { overview, models, overviewWindow:window });
    } else {
      const billing = await adapter.getBilling(window);
      Object.assign(state, { billing, billingWindow:window });
    }
  } catch (error) {
    showToast(`Unable to update ${kind}: ${error.message}`, 'error');
  } finally {
    state.usageLoading[kind] = false;
    render();
  }
}

async function ensureModel(id) {
  if (!state.modelCache.has(id)) state.modelCache.set(id, await adapter.getModel(id));
  return state.modelCache.get(id);
}
async function ensureProvider(id) {
  if (!state.providerCache.has(id)) state.providerCache.set(id, await adapter.getProvider(id));
  return state.providerCache.get(id);
}
