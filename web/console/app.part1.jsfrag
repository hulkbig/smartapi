    sessions:'<path d="M3 4h15v11H7l-4 4V4Zm7 14h7l4 3V8"/>',
    queue:'<path d="M8 5h13M8 12h13M8 19h13M3 5h.01M3 12h.01M3 19h.01"/>',
    warning:'<path d="M12 3 2 21h20L12 3Z"/><path d="M12 9v5m0 3h.01"/>',
