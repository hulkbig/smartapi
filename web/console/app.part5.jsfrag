    ${nextDetailSelected('providers',id,'configuration')?`<section class="card panel v3-configuration-card"><div class="section-head"><div><h2>Provider Configuration ${uiHint("Route dependency",providerImpactText(p))}</h2></div><div class="row-actions"><button class="btn small" data-action="test-provider" data-id="${esc(id)}">Test</button><button class="btn small primary" data-action="edit-provider" data-id="${esc(id)}">Edit Provider</button></div></div>${providerProtocolMatrix(conns)}<div class="grid-2 section"><div><div class="cell-sub">Endpoint</div><div class="cell-title mono">${esc(p.raw?.base_url||'—')}</div><div class="cell-sub" style="margin-top:12px">Credential</div><div class="cell-title">${esc(credential?.type||'Not configured')}</div><div class="cell-sub">${esc(credential?.account||'—')}</div></div><div><div class="cell-sub">Upstream models</div><div class="model-chip-list">${upstreamModels.map(model=>state.models.some(item=>item.id===model)?`<button class="badge blue model-shortcut" data-action="open-model" data-id="${esc(model)}" title="Open same-name Logical Model">${esc(model)} <span>→ Logical Model</span></button>`:`<span class="badge">${esc(model)} · Not listed</span>`).join('')||'<div class="empty"><strong>No upstream models</strong>Edit the provider to add one or more upstream model names.</div>'}</div></div></div></section>`:''}</div>`;
}
function providerProtocolMatrix(connections){
 const rows=connections.flatMap(c=>[...new Set((c.models||[]).flatMap(m=>m.protocols||[]))].map(protocol=>({c,protocol,models:(c.models||[]).filter(m=>(m.protocols||[]).includes(protocol)).map(m=>m.upstream_model)})));
 return `<div class="table-wrap"><table class="table"><thead><tr><th>Protocol</th><th>Account</th><th>Models</th><th>Status</th></tr></thead><tbody>${rows.map(({c,protocol,models})=>`<tr><td>${esc(protocol)}</td><td>${esc(c.account||c.name||c.id)}</td><td>${models.map(esc).join(' · ')}</td><td>${badge(connectionIsEnabled(c)?c.status:'Disabled')}</td></tr>`).join('')||'<tr><td colspan="4">No configured protocols</td></tr>'}</tbody></table></div>`;
}
async function loadAndRenderProvider(id){return loadResourceDetail('providers',id,()=>adapter.getProvider(id),state.providerCache)}
async function loadProviderCodexUsage(id,data){
  if(!id||!data?.provider)return;
  await Promise.all(providerUsageConnections(data.provider,data.connections||[]).map(connection=>loadSharedCodexUsage(id,connection.id)));
}

function requestFilters({limit=state.requestLimit,offset=state.requestOffset}={}){
  const outcome=state.requestFilter==='recovered'?'RECOVERED_SUCCESS':state.requestFilter==='direct'?'DIRECT_SUCCESS':state.requestFilter==='failed'?'FAILED':'';
  const filters={caller_id:state.requestCallerIdentity||'',logical_model:state.requestLogicalModel,participating_provider:state.requestParticipatingProvider,attempt_status:state.requestAttemptStatus,attempt_failure_type:state.requestAttemptFailureType,report_error:state.requestReportError,window:state.requestWindow,q:state.requestSearch,conversation_id:state.requestConversation,model:state.requestModel,provider:state.requestProvider,api_key:state.requestApiKey,connection:state.requestConnection,failure_type:state.requestFailureType,status:['canceled','received','waiting','active','recovering','streaming','delivering'].includes(state.requestFilter)?state.requestFilter:state.requestStatus,runtime_revision:state.requestRevision,outcome,limit,offset};
  if(state.requestFrom)filters.from=new Date(state.requestFrom).toISOString();if(state.requestTo)filters.to=new Date(state.requestTo).toISOString();return filters;
}
let requestLoadGeneration=0;
async function reloadRequests(){
  const generation=++requestLoadGeneration,filters=requestFilters(),scope=JSON.stringify(filters),changed=state.requestQueryKey!==scope;
  if(changed){state.requests=[];state.requestTotal=0;state.requestLastUpdated=null}
  if(typeof persistRequestView==='function')persistRequestView();
  state.requestQueryKey=scope;state.requestLoading=true;state.requestError=null;render();
  try{const requests=await adapter.getRequests(filters);if(generation!==requestLoadGeneration)return;state.requests=requests;state.requestTotal=Number(requests.total??requests.length);state.requestLastUpdated=new Date();}
  catch(error){if(generation===requestLoadGeneration)state.requestError={message:error.message,stale:!changed&&Boolean(state.requestLastUpdated)}}
  finally{if(generation===requestLoadGeneration){state.requestLoading=false;render()}}
}

function requestDataSync(id){
  const detail=state.requestCache.get(id),listed=state.requests.find(r=>r.id===id);
  if(!detail)return listed;if(!listed)return detail;
  const cached=detail.raw?.reference_pricing,latest=listed.raw?.reference_pricing;
  return latest&&(!cached||Date.parse(latest.updated_at)>=Date.parse(cached.updated_at))?{...detail,raw:{...detail.raw,reference_pricing:latest}}:detail;
}
function prettyDebug(value){try{return JSON.stringify(value,null,2)}catch{return String(value??'')}}
const requestDetailLoads=new Map();
async function loadAndRenderRequest(id){
  const entry=detailLoadState('requests',id);if(entry.error)return;
  if(requestDetailLoads.has(id))return requestDetailLoads.get(id).promise;
  for(const [other,load]of requestDetailLoads)if(other!==id){load.controller.abort();requestDetailLoads.delete(other)}
  const controller=new AbortController();
  const promise=Promise.resolve().then(()=>adapter.getRequest(id,{signal:controller.signal})).then(request=>{
    if(controller.signal.aborted)return;
    state.requestCache.set(id,request);if(currentRoute().section==='requests'&&currentRoute().id===id)render();
  }).catch(error=>{if(!controller.signal.aborted&&error?.name!=='AbortError'){entry.error=error;const route=currentRoute();if(route.section==='requests'&&route.id===id)render()}})
    .finally(()=>{if(requestDetailLoads.get(id)?.controller===controller)requestDetailLoads.delete(id)});
  requestDetailLoads.set(id,{promise,controller});return promise;
}
function cancelRequestDetailLoads(){for(const load of requestDetailLoads.values())load.controller.abort();requestDetailLoads.clear();}
document.addEventListener('visibilitychange',()=>{if(document.hidden)cancelRequestDetailLoads();});
window.addEventListener('hashchange',()=>{const route=currentRoute();for(const [id,load]of requestDetailLoads)if(route.section!=='requests'||route.id!==id){load.controller.abort();requestDetailLoads.delete(id)}});
function conversationRequestsSort(left,right){const a=Date.parse(left.timestamp||''),b=Date.parse(right.timestamp||'');if(Number.isFinite(a)&&Number.isFinite(b)&&a!==b)return a-b;const time=String(left.time||'').localeCompare(String(right.time||''));return time||String(left.id||'').localeCompare(String(right.id||''))}
async function loadConversationRequests(conversationId,{force=false}={}){
  if(!conversationId||conversationId==='—')return [];
  if(!force&&state.conversationCache.has(conversationId))return state.conversationCache.get(conversationId);
  if(state.conversationLoading.has(conversationId))return state.conversationLoading.get(conversationId);
  const pending=(async()=>{try{const collected=[];let offset=0,total=0;do{const page=await adapter.getRequests({window:'720h',conversation_id:conversationId,limit:1000,offset});collected.push(...page);offset+=page.length;total=Number(page.total??collected.length);if(!page.length)break;}while(offset<total);const ordered=collected.sort(conversationRequestsSort);state.conversationCache.set(conversationId,ordered);if(state.drawer?.type==='conversation'&&state.drawer.conversationId===conversationId)state.drawer.error='';return ordered;}catch(error){if(state.drawer?.type==='conversation'&&state.drawer.conversationId===conversationId)state.drawer.error=error.message||'Conversation requests could not be loaded.';throw error;}finally{state.conversationLoading.delete(conversationId);render();}})();
  state.conversationLoading.set(conversationId,pending);render();return pending;
}
async function inspectConversationRequest(id){
  const drawer=state.drawer;if(!drawer||drawer.type!=='conversation')return;
  drawer.currentRequestId=id;drawer.error='';
  const item=(state.conversationCache.get(drawer.conversationId)||[]).find(request=>request.id===id);if(item&&!state.requestCache.has(id))state.requestCache.set(id,item);
  history.replaceState(null,'',`#/requests/${encodeURIComponent(id)}`);render();
  try{state.requestCache.set(id,await adapter.getRequest(id));render()}catch(error){drawer.error=error.message||'Request detail could not be loaded.';render();}
}
function decorateRequestConversationTrigger(request){
  const conversationId=request.conversation;if(!conversationId||conversationId==='—')return;
  if(!state.conversationCache.has(conversationId)&&!state.conversationLoading.has(conversationId))loadConversationRequests(conversationId).catch(()=>{});
  const summary=app.querySelector('.request-model-summary'),chip=summary?.querySelector('.request-conversation-summary');if(!chip||chip.classList.contains('request-conversation-trigger')||currentRoute().id!==request.id)return;
  const count=state.conversationCache.get(conversationId)?.length,button=document.createElement('button');button.type='button';button.className=`${chip.className} request-conversation-trigger`;button.dataset.action='open-conversation-trail';button.dataset.conversation=conversationId;button.dataset.id=request.id;button.title=`Open all requests in ${conversationId}`;button.innerHTML=`<span class="request-conversation-icon">${icon('route')}</span><strong class="mono">${esc(conversationId)}</strong><small>Conversation · ${count===undefined?'Loading trail…':`${count} request${count===1?'':'s'}`}</small>`;chip.replaceWith(button);
}
function decorateRequestWindowOptions(){
 const select=app.querySelector('[data-action="request-window"]');if(!select)return;
 for(const [value,label] of [['168h',nt('7 days','7 天')],['720h',nt('30 days','30 天')]])if(!select.querySelector(`option[value="${value}"]`))select.add(new Option(label,value));
 if(state.requestFrom||state.requestTo){const option=new Option(nt('Exact time range','精确时间范围'),'exact');option.disabled=true;select.add(option);select.value='exact';}else select.value=state.requestWindow;
 for(const [action,value,label] of [['request-model',state.requestLogicalModel,nt('Exact match','精确匹配')],['request-provider',state.requestParticipatingProvider,nt('Participating','参与尝试')],['request-filter',state.requestStatus||state.requestAttemptStatus||state.requestAttemptFailureType||state.requestReportError,nt('Report outcome filter','报表结果筛选')]]){
  const field=app.querySelector(`[data-action="${action}"]`);if(!value||!field)continue;const option=new Option(`${value} · ${label}`,'report-scope');option.disabled=true;field.add(option);field.value='report-scope';
 }
}

const requestViewFields=['requestSearch','requestConversation','requestFilter','requestWindow','requestLogicalModel','requestCallerIdentity','requestParticipatingProvider','requestAttemptStatus','requestAttemptFailureType','requestReportError','requestModel','requestProvider','requestApiKey','requestConnection','requestFailureType','requestStatus','requestRevision','requestFrom','requestTo','requestOffset','requestLimit','requestColumns'];
function persistRequestView(){
 if(currentRoute().section!=='requests'||currentRoute().id)return;
 const params=new URLSearchParams(location.hash.split('?')[1]||'');
 params.set('view',JSON.stringify(Object.fromEntries(requestViewFields.map(key=>[key,state[key]??'']))));
 history.replaceState(null,'','#/requests?'+params);state.appliedRequestView=location.hash;
}
function applyRequestViewLocation(){
 if(currentRoute().section!=='requests'||currentRoute().id||state.appliedRequestView===location.hash)return false;
 try{const raw=new URLSearchParams(location.hash.split('?')[1]||'').get('view');if(!raw||raw.length>12000)return false;const view=JSON.parse(raw);state.requestSearchDraft=undefined;for(const key of requestViewFields){const value=view[key];if(key==='requestOffset'){state[key]=Number.isInteger(value)&&value>=0?value:0}else if(key==='requestLimit'){state[key]=[25,50,100].includes(value)?value:25}else if(key==='requestColumns'){state[key]=value===true}else if(typeof value==='string'&&value.length<=2048){if(['requestFrom','requestTo'].includes(key)&&value&&!Number.isFinite(Date.parse(value)))continue;state[key]=value}}
 state.appliedRequestView=location.hash;state.requestAutoRefresh=false;return true;
 }catch{return false}
}
function restoreConsoleLocation(){const report=applyReportLocation(),view=applyRequestViewLocation();return report||view}
function resourceReturnHash(fallback='#/requests'){
 const back=new URLSearchParams(location.hash.split('?')[1]||'').get('back');
 return back&&back.length<16000&&/^#\/(requests|sessions|providers|models|queue|api-keys|billing)([/?]|$)/.test(back)?back:fallback;
}
function openRequestFromCurrent(id){
 const scope=state.requests?.scope;if(scope?.from&&scope?.to){state.requestFrom=scope.from;state.requestTo=scope.to}persistRequestView();const back=location.hash;closeOverlay();location.hash=resourceHash('requests',id)+'?back='+encodeURIComponent(back);
}
