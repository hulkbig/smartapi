function expireConsoleSession(){
  if(!state.auth?.authenticated)return;
  state.auth={initialized:true,authenticated:false,username:state.auth.username};state.sessionExpired=true;state.bootGeneration=(state.bootGeneration||0)+1;state.sessionEpoch=(state.sessionEpoch||0)+1;state.editorDirty=false;state.backupDraft=null;
  state.modal=null;state.drawer=null;state.wizard={authUsername:state.auth.username||''};state.routingDraft=null;state.routingReview=null;
  state.loading=false;state.error=null;state.keyLoading=false;state.keyError='';clearCodexUsageResetState();stopOAuthDeviceWatch();cancelRequestDetailLoads();
  for(const ctx of observationContexts.values()){ctx.resource.cancel();ctx.graph?.destroy()}
  activeObservationContext=null;portal.innerHTML='';render();
}

async function submitAuthForm(form){
  state.formSubmissions||=new Set();const submissionKey=form.dataset.form;if(form.dataset.submitting==='true'||state.formSubmissions.has(submissionKey))return;state.formSubmissions.add(submissionKey);form.dataset.submitting='true';
  const submittingModal=state.modal;if(submittingModal&&['management-token-create','management-token-edit','change-password'].includes(submissionKey))submittingModal.busy=true;
  const submit=form.querySelector('[type=submit]');if(submit)submit.disabled=true;
  const values=new FormData(form),username=String(values.get('username')||'').trim(),password=String(values.get('password')||'');
  try{
    if(form.dataset.form==='management-token-create'){
      const name=String(values.get('name')||'').trim(),description=String(values.get('description')||'').trim(),expires=String(values.get('expires_at')||'');
      if(!name){showToast('Token name is required','error');return;}
      const result=await adapter.createManagementToken({name,description,allow_high_risk:values.get('allow_high_risk')==='on',...(expires?{expires_at:new Date(expires).toISOString()}:{})});
      state.modal={type:'management-token-reveal',secret:result.secret,name:result.token?.name||name,rotated:false};renderPortal();showToast('Management token created');void refreshManagementSecurityAfterWrite();return;
    }else if(form.dataset.form==='management-token-edit'){
      const name=String(values.get('name')||'').trim(),description=String(values.get('description')||'').trim(),expires=String(values.get('expires_at')||'');
      if(!name){showToast('Token name is required','error');return;}
      await adapter.updateManagementToken(form.dataset.id,{name,description,...(expires?{expires_at:new Date(expires).toISOString()}:{clear_expiry:true})});
      await refreshManagementSecurity();closeOverlay();render();showToast('Management token updated');return;
    }else if(form.dataset.form==='initialize'){
      if(password!==String(values.get('confirmation')||'')){showToast('Password confirmation does not match','error');return;}
      await adapter.initializeAdmin({username,password});
    }else if(form.dataset.form==='login'){
      await adapter.login({username,password});
    }else if(form.dataset.form==='change-password'){
      const next=String(values.get('new_password')||''),confirmation=String(values.get('confirmation')||'');
      if(next!==confirmation){showToast('Password confirmation does not match','error');return;}
      await adapter.changePassword({current_password:password,new_password:next});
      expireConsoleSession();state.sessionExpired=false;render();showToast('Password changed. Sign in again.');return;
    }
    state.sessionExpired=false;await boot().then(()=>pollCodexUsageResets());
  }catch(error){showToast(error.message,'error')}finally{state.formSubmissions.delete(submissionKey);form.dataset.submitting='false';if(submittingModal)submittingModal.busy=false;if(submit)submit.disabled=false}
}
app.addEventListener('submit',async(event)=>{const form=event.target.closest('[data-form]');if(!form)return;event.preventDefault();await submitAuthForm(form)});
portal.addEventListener('submit',async(event)=>{const form=event.target.closest('[data-form]');if(!form)return;event.preventDefault();await submitAuthForm(form)});

app.addEventListener('change',async(event)=>{
  const el=event.target;
  if(el.dataset.action?.startsWith('request-')) forgetReportLocation();
  if(el.dataset.action==='request-columns'){state.requestColumns=el.checked;render();return;}
  if(el.dataset.action==='scenario-change'){state.scenario=el.value;state.modelCache.clear();state.providerCache.clear();render();return;}
  if(el.dataset.action==='request-filter'){state.requestStatus='';state.requestReportError='';state.requestAttemptStatus='';state.requestAttemptFailureType='';state.requestFilter=el.value;state.requestOffset=0;await reloadRequests();return;}
  if(el.dataset.action==='request-window'){state.requestFrom='';state.requestTo='';state.requestWindow=el.value;state.requestOffset=0;await reloadRequests();return;}
  if(el.dataset.action==='request-model'){state.requestLogicalModel='';state.requestModel=el.value;state.requestOffset=0;await reloadRequests();return;}
  if(el.dataset.action==='request-provider'){state.requestParticipatingProvider='';state.requestAttemptStatus='';state.requestAttemptFailureType='';state.requestProvider=el.value;state.requestOffset=0;await reloadRequests();return;}
  if(el.dataset.action==='overview-window'){await changeUsageWindow('overview',el.value);return;}
  if(el.dataset.action==='key-status'){state.keyStatus=el.value;render();return;}
  if(el.dataset.action==='model-status'){state.modelStatus=el.value;render();return;}
  if(el.dataset.action==='model-type'){state.modelType=el.value;render();return;}
  if(el.dataset.action==='request-api-key'){state.requestApiKey=el.value;state.requestOffset=0;await reloadRequests();return;}
  if(el.dataset.action==='request-connection'){state.requestConnection=el.value;state.requestOffset=0;await reloadRequests();return;}
  if(el.dataset.action==='request-failure'){state.requestFailureType=el.value;state.requestOffset=0;await reloadRequests();return;}
  if(el.dataset.action==='request-status'){state.requestStatus=el.value;state.requestOffset=0;await reloadRequests();return;}
  if(el.dataset.action==='request-revision'){state.requestRevision=el.value;state.requestOffset=0;await reloadRequests();return;}
  if(el.dataset.action==='request-from'){state.requestFrom=el.value;state.requestOffset=0;await reloadRequests();return;}
  if(el.dataset.action==='request-to'){state.requestTo=el.value;state.requestOffset=0;await reloadRequests();return;}
  if(el.dataset.action==='request-limit'){state.requestLimit=Number(el.value);state.requestOffset=0;await reloadRequests();return;}
  if(el.dataset.action==='billing-window'){await changeUsageWindow('billing',el.value);return;}
  if(el.dataset.action==='debug-capture'){try{state.settings=await adapter.updateSettings({debug_request_response:el.checked});showToast(`Request/response debug ${el.checked?'enabled':'disabled'}`);render();}catch(error){showToast(error.message,'error');render()}return;}
  if(el.dataset.action==='codex-usage-threshold'||el.dataset.action==='codex-allow-credits'){await updateCodexUsageProtectionSetting(el);return;}
  if(el.dataset.action==='auto-reset-enabled'||el.dataset.action==='auto-reset-threshold'){await updateAutomaticUsageResetSetting(el);return;}
  if(el.dataset.action==='scheduled-sync'){try{state.settings=await adapter.updateSettings({scheduled_model_sync_enabled:el.checked});showToast(`Scheduled model sync ${el.checked?'enabled':'paused'}`);render();}catch(error){showToast(error.message,'error');render()}return;}
  if(['pricing-enabled','pricing-source','pricing-interval'].includes(el.dataset.action)){
    const settings={...(state.settings?.pricing_sync?.settings||{enabled:true,source:'litellm',interval_hours:24})};
    if(el.dataset.action==='pricing-enabled')settings.enabled=el.checked;
    if(el.dataset.action==='pricing-source')settings.source=el.value;
    if(el.dataset.action==='pricing-interval'){const hours=Number(el.value);if(!Number.isInteger(hours)||hours<1||hours>168){showToast('Enter whole hours between 1 and 168','error');render();return}settings.interval_hours=hours}
    try{state.settings=await adapter.updateSettings({pricing_sync:settings});showToast('Reference price schedule saved');render()}catch(error){showToast(error.message,'error');render()}return;
  }
  if(el.dataset.action==='codex-auto-update'){state.codexAutoUpdateDraft=el.checked;render();return;}
  if(el.dataset.action==='codex-release-channel'){state.codexReleaseChannelDraft=el.value;return;}
  if(el.dataset.action==='auto-logical-limit'){
    const value=Number(el.value);
    if(el.value.trim()===''||!Number.isInteger(value)||value<0||value>10000){showToast('Enter a whole number between 0 and 10000','error');render();return;}
    try{state.settings=await adapter.updateSettings({auto_logical_model_limit:value});state.models=await adapter.getModels(state.overviewWindow);state.providerCache.clear();state.modelCache.clear();showToast('Automatic Logical Model limit saved');render();}catch(error){showToast(error.message,'error');render()}return;
  }
  if(el.dataset.action==='management-token-high-risk'){try{await adapter.updateManagementToken(el.dataset.id,{allow_high_risk:el.checked});await refreshManagementSecurity();showToast(`High-risk operations ${el.checked?'allowed':'blocked'} for this token`);render();}catch(error){showToast(error.message,'error');render()}return;}
});

app.addEventListener('input',(event)=>{
  const el=event.target;
  if(el.dataset.action==='codex-client-version'){state.codexVersionDraft=el.value;return;}
  const inputName=el.dataset.input;
  if(!inputName)return;
  if(inputName==='models-search') state.modelsSearch=el.value;
  else if(inputName==='provider-search') state.providerSearch=el.value;
  else if(inputName==='request-search'){state.requestSearchDraft=el.value;const pending=app.querySelector?.('[data-request-query-pending]');if(pending)pending.textContent=el.value!==state.requestSearch?nt('Search not applied','搜索尚未应用'):'';return;}
  else if(inputName==='key-search') state.keySearch=el.value;
  else return;
  const start=el.selectionStart ?? el.value.length;
  const end=el.selectionEnd ?? start;
  render();
  requestAnimationFrame(()=>{
    const next=app.querySelector(`[data-input="${inputName}"]`);
    if(!next)return;
    next.focus({preventScroll:true});
    try{next.setSelectionRange(start,end)}catch{}
  });
});

app.addEventListener('keydown',async(event)=>{
  const el=event.target,rowLink=el.closest?.('tr[data-action][role="link"]'),nestedControl=el!==rowLink&&el.closest?.('button,a,input,select,textarea,summary');
  if(rowLink&&!nestedControl&&(event.key==='Enter'||event.key===' ')){event.preventDefault();rowLink.click();return;}
  if(el.dataset.input!=='request-search'||event.key!=='Enter'||event.isComposing)return;
  event.preventDefault();state.requestSearch=state.requestSearchDraft??state.requestSearch;state.requestSearchDraft=undefined;forgetReportLocation();state.requestOffset=0;await reloadRequests();
});

portal.addEventListener('click', async (event)=>{
  const el=event.target.closest('[data-action]'); if(!el)return;
  if(el.classList.contains('modal-backdrop'))return;
  const proxy=document.createElement('button'); proxy.dataset.action=el.dataset.action; for(const [k,v] of Object.entries(el.dataset))proxy.dataset[k]=v; app.appendChild(proxy); proxy.click(); proxy.remove();
});
function updateOverrideConditionState(name){const w=state.wizard.override,node=portal.querySelector(`[data-condition-state="${name}"]`);if(!w||!node)return;const required=w.required||{},configured=name==='caller'?Boolean(w.callers.trim()):name==='protocol'?Boolean(w.protocols?.length):name==='schedule'?Boolean(w.weekdays?.length||w.start||w.end):Boolean(overrideCapabilityOptions.some(([value])=>required[value])||Number(required.min_context||0)||Number(required.min_output||0));node.textContent=configured?'Configured · must match':'Not selected · group passes';node.classList.toggle('configured',configured)}
portal.addEventListener('change',async(event)=>{
  const el=event.target;
  if(el.dataset.scopeOwner){
    const w=state.wizard[el.dataset.scopeOwner],field=el.dataset.scopeField;if(!w||!['models','protocols'].includes(field))return;
    const selected=new Set(String(w[field]||'').split(',').map(v=>v.trim()).filter(Boolean));
    if(el.hasAttribute('data-scope-all'))selected.clear();else if(el.checked)selected.add(el.value);else selected.delete(el.value);
    w[field]=[...selected].join(', ');
    const picker=el.closest('[data-scope-picker]');picker.querySelector('[data-scope-all]').checked=selected.size===0;
    picker.querySelectorAll('[data-scope-option] input').forEach(input=>input.checked=selected.has(input.value));return;
  }
  if(el.dataset.wizard==='provider-auth-file'||el.dataset.wizard==='connection-auth-file'){
    const file=el.files?.[0]||null;if(!file)return;
    if(!String(file.name||'').toLowerCase().endsWith('.json')){showToast('Choose a .json credential file','error');el.value='';return;}
    if(file.size>128*1024){showToast('auth.json must be 128 KiB or smaller','error');el.value='';return;}
    const target=el.dataset.wizard==='provider-auth-file'?state.wizard.provider:state.wizard.connection;
    target.authFile=file;target.authFileName=file.name;renderPortal();return;
  }
  if(el.dataset.action==='audit-filter'){state.auditFilters||={};state.auditFilters[el.dataset.field]=el.value;render();return;}
  if(el.dataset.action==='provider-status'){state.providerStatus=el.value;render();return;}
  if(el.dataset.action==='routing-provider-select'){state.routingValidationErrors=null;state.wizard.routingProvider=el.value;renderPortal();return;}
  if(el.dataset.action==='routing-conversation'){state.routingValidationErrors=null;state.routingDraft.conversationStrategy=el.value;return;}
  if(el.dataset.action==='routing-recover'){const route=state.routingDraft.routes[Number(el.dataset.index)],failure=el.dataset.failure;if(!route)return;state.routingValidationErrors=null;route.recoverOn=normalizeRoutingFailures(route.recoverOn);if(el.checked&&!route.recoverOn.includes(failure))route.recoverOn.push(failure);if(!el.checked)route.recoverOn=route.recoverOn.filter(value=>value!==failure);return;}
  if(el.dataset.action==='routing-provider'){const route=state.routingDraft.routes[Number(el.dataset.index)],provider=state.providers.find(item=>item.id===el.value);if(!route||!provider)return;state.routingValidationErrors=null;Object.assign(route,{id:provider.id,provider:provider.name,model:'',status:provider.status,serving:0});renderPortal();return;}
  if(el.dataset.action==='routing-model'){const route=state.routingDraft.routes[Number(el.dataset.index)];if(!route)return;state.routingValidationErrors=null;route.model=el.value;renderPortal();return;}
  if(el.dataset.wizard==='connection-protocol'){state.wizard.connection.protocol=el.value;return;}
  if(el.dataset.wizard==='provider-protocol'){state.wizard.provider.protocol=el.value;if(providerModelDiscoveryReady(state.wizard.provider))await discoverProviderModels();return;}
  if(el.dataset.wizard==='provider-auth-type'){state.wizard.provider.authType=el.value;state.wizard.provider.models=[];state.wizard.provider.modelOptions=[];state.wizard.provider.modelsLoaded=false;state.wizard.provider.modelsError='';renderPortal();if(providerModelDiscoveryReady(state.wizard.provider))await discoverProviderModels();return;}
  if(el.dataset.wizard==='provider-model-option'){const selected=new Set(state.wizard.provider.models||[]);if(el.checked)selected.add(el.value);else selected.delete(el.value);state.wizard.provider.models=[...selected];const count=portal.querySelector('[data-provider-model-selected]');if(count)count.textContent=String(selected.size);return;}
  if(['provider-base-url','provider-secret','provider-credential-ref'].includes(el.dataset.wizard)&&providerModelDiscoveryReady(state.wizard.provider)){await discoverProviderModels();return;}
  if(el.dataset.wizard==='key-exact-only')state.wizard.key.exactOnly=el.checked;
  if(el.dataset.wizard==='policy-exact-only')state.wizard.keyPolicy.exactOnly=el.checked;
  if(el.dataset.wizard==='model-exact-only')state.wizard.model.exactOnly=el.checked;
  if(el.dataset.wizard==='model-enabled')state.wizard.model.enabled=el.checked;
  if(el.dataset.wizard==='override-enabled')state.wizard.override.enabled=el.checked;
  if(el.dataset.action==='override-protocol'){const values=new Set(state.wizard.override.protocols||[]);el.checked?values.add(el.value):values.delete(el.value);state.wizard.override.protocols=[...values];updateOverrideConditionState('protocol');return;}
  if(el.dataset.action==='override-weekday'){const values=new Set(state.wizard.override.weekdays||[]);el.checked?values.add(el.value):values.delete(el.value);state.wizard.override.weekdays=[...values];updateOverrideConditionState('schedule');return;}
  if(el.dataset.action==='override-capability'){state.wizard.override.required||={};state.wizard.override.required[el.value]=el.checked;updateOverrideConditionState('requirements');return;}
  if(el.dataset.action==='override-mode'){state.wizard.override.mode=el.value;state.wizard.override.customRouteChoice='';renderPortal();return;}
  if(el.dataset.action==='override-adjust'){state.wizard.override.adjustments[Number(el.dataset.index)]=el.value;return;}
  if(el.dataset.action==='override-route-select'){state.wizard.override.customRouteChoice=el.value;renderPortal();return;}
  if(el.dataset.action==='override-route-recover'){const route=state.wizard.override.customRoutes[Number(el.dataset.index)],failure=el.dataset.failure;if(!route)return;route.recoverOn=normalizeRoutingFailures(route.recoverOn);if(el.checked&&!route.recoverOn.includes(failure))route.recoverOn.push(failure);if(!el.checked)route.recoverOn=route.recoverOn.filter(value=>value!==failure);return;}
  if(el.dataset.wizard==='simulation-protocol'){state.wizard.simulation.protocol=el.value;return;}
  if(el.dataset.wizard==='simulation-stream'){state.wizard.simulation.stream=el.checked;return;}
  if(el.dataset.action==='simulation-capability'){state.wizard.simulation.required||={};state.wizard.simulation.required[el.value]=el.checked;return;}
  if(el.dataset.wizard==='provider-edit-enabled')state.wizard.providerEdit.enabled=el.checked;
  if(el.dataset.wizard==='provider-edit-protocol'){state.wizard.providerEdit.protocol=el.value;if(providerEditModelDiscoveryReady(state.wizard.providerEdit))await discoverProviderEditModels();return;}
  if(el.dataset.wizard==='provider-edit-url'&&providerEditModelDiscoveryReady(state.wizard.providerEdit)){await discoverProviderEditModels();return;}
  if(el.dataset.wizard==='connection-edit-stream')state.wizard.connectionEdit.stream=el.checked;
  if(el.dataset.wizard==='connection-edit-tools')state.wizard.connectionEdit.tools=el.checked;
  if(el.dataset.wizard==='connection-edit-protocol')state.wizard.connectionEdit.protocol=el.value;
});
portal.addEventListener('input',(event)=>{
  const el=event.target;
  if(el.dataset.scopeSearch!==undefined){const query=el.value.trim().toLowerCase();el.closest('[data-scope-picker]').querySelectorAll('[data-scope-option]').forEach(row=>row.hidden=Boolean(query&&!row.dataset.search.includes(query)));return;}
  if(el.dataset.wizard==='provider-name') state.wizard.provider.name=el.value;
  if(el.dataset.wizard==='provider-base-url') state.wizard.provider.baseUrl=el.value;
  if(el.dataset.wizard==='provider-account') state.wizard.provider.account=el.value;
  if(el.dataset.wizard==='provider-model-filter'){state.wizard.provider.modelFilter=el.value;updateProviderModelFilterUI();return;}
  if(el.dataset.wizard==='provider-secret') state.wizard.provider.secret=el.value;
  if(el.dataset.wizard==='provider-credential-ref') state.wizard.provider.credentialRef=el.value;
  if(el.dataset.wizard==='connection-account') state.wizard.connection.account=el.value;
  if(el.dataset.wizard==='connection-models') state.wizard.connection.models=el.value;
  if(el.dataset.wizard==='connection-secret') state.wizard.connection.secret=el.value;
  if(el.dataset.wizard==='connection-credential-ref') state.wizard.connection.credentialRef=el.value;
  if(el.dataset.wizard==='oauth-callback') state.wizard.oauthCallback=el.value;
  if(el.dataset.wizard==='key-name') state.wizard.key.name=el.value;
  if(el.dataset.wizard==='key-description') state.wizard.key.description=el.value;
  if(el.dataset.wizard==='key-models') state.wizard.key.models=el.value;
  if(el.dataset.wizard==='key-protocols') state.wizard.key.protocols=el.value;
  if(el.dataset.wizard==='key-expires') state.wizard.key.expiresAt=el.value;
  if(el.dataset.wizard==='key-rate') state.wizard.key.rateLimitRPM=el.value;
  if(el.dataset.wizard==='key-budget') state.wizard.key.monthlyBudgetUSD=el.value;
  if(el.dataset.wizard==='model-id') state.wizard.model.id=el.value;
  if(el.dataset.wizard==='model-name') state.wizard.model.name=el.value;
  if(el.dataset.wizard==='model-description') state.wizard.model.description=el.value;
  if(el.dataset.wizard==='model-first-output-timeout') state.wizard.model.firstOutputTimeoutSeconds=el.value;
  if(el.dataset.wizard==='override-id') state.wizard.override.id=el.value;
  if(el.dataset.wizard==='override-name') state.wizard.override.name=el.value;
  if(el.dataset.wizard==='override-callers'){state.wizard.override.callers=el.value;updateOverrideConditionState('caller');}
  if(el.dataset.wizard==='override-timezone') state.wizard.override.timezone=el.value;
  if(el.dataset.wizard==='override-start'){state.wizard.override.start=el.value;updateOverrideConditionState('schedule');}
  if(el.dataset.wizard==='override-end'){state.wizard.override.end=el.value;updateOverrideConditionState('schedule');}
  if(el.dataset.wizard==='override-min-context'){state.wizard.override.required||={};state.wizard.override.required.min_context=el.value;updateOverrideConditionState('requirements');}
  if(el.dataset.wizard==='override-min-output'){state.wizard.override.required||={};state.wizard.override.required.min_output=el.value;updateOverrideConditionState('requirements');}
  if(el.dataset.wizard==='simulation-caller')state.wizard.simulation.caller=el.value;
  if(el.dataset.wizard==='simulation-at')state.wizard.simulation.at=el.value;
  if(el.dataset.wizard==='simulation-min-context'){state.wizard.simulation.required||={};state.wizard.simulation.required.min_context=el.value;}
  if(el.dataset.wizard==='simulation-min-output'){state.wizard.simulation.required||={};state.wizard.simulation.required.min_output=el.value;}
  if(el.dataset.wizard==='provider-edit-name') state.wizard.providerEdit.name=el.value;
  if(el.dataset.wizard==='provider-edit-url') state.wizard.providerEdit.baseUrl=el.value;
  if(el.dataset.wizard==='provider-edit-identity') state.wizard.providerEdit.identity=el.value;
  if(el.dataset.wizard==='provider-edit-model-input') state.wizard.providerEdit.modelInput=el.value;
  if(el.dataset.wizard==='provider-edit-model-filter'){state.wizard.providerEdit.modelFilter=el.value;updateProviderEditModelFilterUI();return;}
  if(el.dataset.wizard==='provider-unlisted-filter'){state.wizard.providerEdit.unlistedFilter=el.value;updateProviderUnlistedFilterUI();return;}
  if(el.dataset.wizard==='provider-unlisted-option'){const w=state.wizard.providerEdit;if(w&&w.type!=='cliproxy-codex'){const selected=new Set(w.unlistedSelected||[]);if(el.checked)selected.add(el.value);else selected.delete(el.value);w.unlistedSelected=[...selected];updateProviderUnlistedUI(w);}return;}
  if(el.dataset.wizard==='connection-edit-identity') state.wizard.connectionEdit.identity=el.value;
  if(el.dataset.wizard==='connection-edit-credential') state.wizard.connectionEdit.credentialRef=el.value;
  if(el.dataset.wizard==='connection-edit-models') state.wizard.connectionEdit.models=el.value;
  if(el.dataset.wizard==='policy-description') state.wizard.keyPolicy.description=el.value;
  if(el.dataset.wizard==='policy-models') state.wizard.keyPolicy.models=el.value;
  if(el.dataset.wizard==='policy-protocols') state.wizard.keyPolicy.protocols=el.value;
  if(el.dataset.wizard==='policy-expires') state.wizard.keyPolicy.expiresAt=el.value;
  if(el.dataset.wizard==='policy-rate') state.wizard.keyPolicy.rate=el.value;
  if(el.dataset.wizard==='policy-budget') state.wizard.keyPolicy.budget=el.value;
});
portal.addEventListener('keydown',(event)=>{
  const el=event.target;
  if(el.dataset.wizard!=='provider-edit-model-input'||event.key!=='Enter'||event.isComposing)return;
  event.preventDefault();
  const w=state.wizard.providerEdit;
  if(!String(w?.modelInput||'').trim())return;
  addProviderEditModelNames(w,w.modelInput);
  renderPortal();
});

function normalizeRoutingFailures(values){return [...new Set((values||[]).map(value=>value==='connect'?'connect_failure':value).filter(Boolean))]}
function defaultRoutingFailures(){return ['connect_failure','rate_limit','provider_5xx','quota_exhausted','ttft_timeout','stream_broken','bad_response']}
function normalizeRoutingRoutes(routes){return JSON.parse(JSON.stringify(routes||[])).map(route=>({...route,recoverOn:normalizeRoutingFailures(route.recoverOn)}))}
function routingDrawer(modelId){
  const data=modelDataSync(modelId);if(!state.routingDraft)state.routingDraft={routes:normalizeRoutingRoutes(data.routes),conversationStrategy:data.model?.conversationStrategy||'keep-existing'};
  const d=state.routingDraft,providers=state.providers;
  const failures=[['connect_failure','Connection failed'],['rate_limit','Rate limited'],['provider_5xx','Provider server error'],['quota_exhausted','Quota exhausted'],['ttft_timeout','First-token timeout'],['stream_broken','Stream interrupted'],['bad_response','Invalid provider response']];
  const routeLabels=routes=>(routes||[]).map(route=>`${esc(route.provider||route.id)} (${esc(route.model)})`).join(' → ')||'—';
  const conflict=state.routingConflict?`<div class="notice red routing-message"><strong>Revision conflict</strong><span>${esc(state.routingConflict.message)} The latest runtime was loaded. Review again before applying.</span><span><b>Your reviewed route:</b> ${routeLabels(state.routingConflict.attemptedRoutes)}</span><span><b>Latest route:</b> ${routeLabels(state.routingConflict.latestRoutes)}</span></div>`:'';
  const validationErrors=(state.routingValidationErrors||[]).filter(Boolean);
  const validation=validationErrors.length?`<div class="notice red routing-message"><strong>Cannot review this route</strong><ul>${validationErrors.map(message=>`<li>${esc(message)}</li>`).join('')}</ul></div>`:'';
  const routeCards=d.routes.map((r,i)=>{
    const provider=providers.find(p=>p.id===r.id),rawCatalog=provider?.raw?.model_catalog||[],catalog=rawCatalog.length?rawCatalog:(provider?.upstreamModels||[]).map(upstream_model=>({upstream_model})),known=catalog.some(m=>m.upstream_model===r.model),canAdvance=i<d.routes.length-1;
    const providerOptions=providers.map(item=>`<option value="${esc(item.id)}" ${item.id===r.id?'selected':''}>${esc(item.name)}</option>`).join('');
    const modelOptions=[`<option value="" ${r.model?'':'selected'} disabled>Select the actual upstream model…</option>`,...(!known&&r.model?[`<option value="${esc(r.model)}" selected>${esc(r.model)} (not in current catalog)</option>`]:[]),...catalog.map(m=>`<option value="${esc(m.upstream_model)}" ${m.upstream_model===r.model?'selected':''}>${esc(m.upstream_model)}</option>`)].join('');
    const recovery=canAdvance?`<details class="recovery-advanced"><summary>When to advance to route ${i+2} <span>Advanced</span></summary><p>Only checked operational upstream failures advance. An empty set stops operational recovery; compatibility failures detected before response commit still advance automatically. Request errors are never eligible.</p><div class="recover-grid">${failures.map(([value,label])=>`<label><input type="checkbox" data-action="routing-recover" data-index="${i}" data-failure="${value}" ${(r.recoverOn||[]).includes(value)?'checked':''}> <span>${label}</span></label>`).join('')}</div></details>`:'';
    const position=i===0?'Requests start here.':`Tried after route ${i}.`;
    return `<section class="route-editor-card ${r.model?'':'route-model-missing'}"><span class="route-priority">${i+1}</span><label class="route-editor-field"><span>Provider</span><select class="select" data-action="routing-provider" data-index="${i}">${providerOptions}</select></label><label class="route-editor-field"><span>Actual upstream model</span><select class="select" data-action="routing-model" data-index="${i}">${modelOptions}</select>${r.model?'':`<small>Select a model explicitly for route ${i+1}.</small>`}</label><div class="route-editor-actions" aria-label="Route ${i+1} actions"><button class="btn icon small" title="Move up" aria-label="Move route ${i+1} up" data-action="routing-up" data-index="${i}" ${i===0?'disabled':''}>${icon('up')}</button><button class="btn icon small" title="Move down" aria-label="Move route ${i+1} down" data-action="routing-down" data-index="${i}" ${i===d.routes.length-1?'disabled':''}>${icon('down')}</button><button class="btn icon small" title="Duplicate route" aria-label="Duplicate route ${i+1}" data-action="routing-duplicate" data-index="${i}">${icon('copy')}</button><button class="btn icon small danger" title="Remove route" aria-label="Remove route ${i+1}" data-action="routing-remove" data-index="${i}" ${d.routes.length===1?'disabled':''}>${icon('trash')}</button></div><div class="route-footnote"><span>${position}</span>${canAdvance?'':'<span class="route-final-note">Final route · no further recovery</span>'}</div>${recovery}</section>`;
  }).join('');
  const providerOptions=providers.map(provider=>`<option value="${esc(provider.id)}" ${state.wizard.routingProvider===provider.id?'selected':''}>${esc(provider.name)}</option>`).join('');
  return `<div class="modal-backdrop" data-action="close-overlay"><div class="modal routing-editor-modal" data-modal-stop><div class="modal-head"><div><h2>Edit Routing</h2><div class="cell-sub">${esc(modelId)} · routes are tried from top to bottom</div></div><button class="btn icon ghost" data-action="close-overlay">×</button></div><div class="modal-body routing-editor-body">${conflict}${validation}<div class="routing-order-explainer"><div><span>1</span>${icon('arrow')}<span>2</span>${icon('arrow')}<span>3</span></div><p>Start with route 1. Continue only for the failure types selected on that route, or when it has no eligible connection. Client request errors stop immediately.</p></div><div class="routing-section-head"><div><h3>Route order</h3></div></div><div class="route-editor-list">${routeCards||'<div class="empty compact-empty"><strong>No route configured</strong>Add a route before enabling or simulating this model.</div>'}</div><div class="routing-add-row"><select class="select" data-action="routing-provider-select"><option value="">Select a Provider for the new route…</option>${providerOptions}</select><button class="btn" data-action="routing-add-route" ${providers.length&&state.wizard.routingProvider?'':'disabled'}>${icon('plus')} Add route</button></div><div class="field routing-conversation"><label>Existing conversations after this change</label><select class="select" data-action="routing-conversation"><option value="keep-existing" ${d.conversationStrategy==='keep-existing'?'selected':''}>Keep their current route while it remains eligible</option><option value="migrate" ${d.conversationStrategy==='migrate'?'selected':''}>Move to the new route on the next request</option></select><span class="hint">New conversations use the new revision. In-flight requests always finish on the revision they started with.</span></div><div class="notice routing-message"><strong>Review before apply</strong><span>The review preserves the selected failure conditions and conversation strategy. Nothing changes until Apply succeeds.</span></div></div><div class="modal-foot"><button class="btn" data-action="close-overlay">Cancel</button><button class="btn primary" data-action="routing-review" data-model="${esc(modelId)}" ${d.routes.length&&!d.routes.some(route=>!route.model)?'':'disabled'}>Review Changes</button></div></div></div>`;
}

function pageOverviewV3(){
  const o=state.overview||emptyOverview(),sv=scenarioView(),managed=demoMode?(sv.managedEvents||[]):Array.isArray(o.managedEvents)?o.managedEvents:[],alerts=(state.alerts||[]).slice(0,4),trend=demoMode?(sv.trend||[]):(o.trend||[]);
  const hasTraffic=sv.hasTraffic!==false&&o.hasTraffic!==false,failed=Number(sv.failed||0),clientStatus=o.clientStatus||(hasTraffic?(failed>0?'Degraded':'Healthy'):'No traffic');
  const successLabel=hasTraffic?`${(100-failed).toFixed(2)}%`:'—',overallStatus=demoMode?sv.system:(o.overallStatus||o.runtimeStatus||o.systemStatus||'Unknown');
  const trafficTrends=demoMode?(sv.trafficTrends||{}):(o.trafficTrends||{}),callPoints=trend.map(point=>({from:point.from,to:point.to,requests:Number(point.requests||0),succeeded:Number(point.succeeded||0),failed:Number(point.failed||0)}));
  const callRequests=callPoints.reduce((sum,point)=>sum+point.requests,0),callSucceeded=callPoints.reduce((sum,point)=>sum+point.succeeded,0);
  const callSeries=callPoints.length?[{id:'all-requests',label:'All requests',requests:callRequests,succeeded:callSucceeded,failed:callRequests-callSucceeded,successRate:callRequests?callSucceeded/callRequests*100:null,points:callPoints}]:[];
  const scaleCacheMetric=metric=>{if(!demoMode)return metric||{};const factor=sv.windowMinutes/15,value=metric||{};return {...value,requests:Number(value.requests||0)*factor,observedRequests:Number(value.observedRequests||0)*factor,eligibleInputTokens:Number(value.eligibleInputTokens||0)*factor,cacheReadTokens:Number(value.cacheReadTokens||0)*factor,cacheWriteTokens:Number(value.cacheWriteTokens||0)*factor}};
  const sourceCache=o.cacheHit||{},cacheHit={overall:scaleCacheMetric(sourceCache.overall),apiKeys:(sourceCache.apiKeys||[]).map(scaleCacheMetric),logicalModels:(sourceCache.logicalModels||[]).map(scaleCacheMetric)},overallCache={...emptyCacheHitMetric('overall'),...(cacheHit.overall||{})};
  const cacheRate=overallCache.hitRate===null||overallCache.hitRate===undefined?0:Math.max(0,Math.min(100,Number(overallCache.hitRate)));
  const keyCache=completeCacheHitDimensions(cacheHit.apiKeys,state.apiKeys,item=>item.name||item.id,item=>item.name||item.id);
  const modelCache=completeCacheHitDimensions(cacheHit.logicalModels,state.models,item=>item.id,item=>item.name||item.id);
  return `${scenarioBanner()}<div class="v3-page v3-overview-page">
    <div class="page-head v3-page-head"><div class="head-main"><div class="v3-eyebrow">${badge(overallStatus)}</div><h1>Overview</h1><p>${esc(o.statusSummary||(hasTraffic?`Client traffic is ${String(clientStatus).toLowerCase()}. SmartAPI recovered ${Number(sv.recoveredCount||0)} requests in the selected window.`:'No client requests were recorded in the selected window.'))}</p></div><div class="head-actions"><select class="select" aria-label="Overview time window" data-action="overview-window" ${state.usageLoading.overview?'disabled':''}><option value="15m" ${state.overviewWindow==='15m'?'selected':''}>Last 15 min</option><option value="1h" ${state.overviewWindow==='1h'?'selected':''}>Last hour</option><option value="24h" ${state.overviewWindow==='24h'?'selected':''}>Last 24 hours</option><option value="168h" ${state.overviewWindow==='168h'?'selected':''}>Last 7 days</option></select><button class="btn icon" data-action="refresh" aria-label="Refresh overview">${icon('refresh')}</button></div></div>
    <section class="card panel v3-experience-panel"><h2>Client Experience</h2><div class="v3-experience-card"><div class="v3-success-score"><strong>${successLabel}</strong><span>Client Success</span></div><div class="v3-legend"><div><i class="blue"></i><span>Direct Success</span><strong>${fmtPct(sv.direct)}</strong></div><div><i class="green"></i><span>Recovered</span><strong>${fmtPct(sv.recovered)}</strong></div><div><i class="red"></i><span>Failed</span><strong>${fmtPct(sv.failed)}</strong></div></div><div class="v3-metric-strip"><div><strong>${esc(o.activeConversations??'—')}</strong><small>Active Conversations</small></div><div><strong>${esc(demoMode?sv.requestRate:o.requestRate??'—')}</strong><small>Requests / min</small></div><div><strong>${esc(o.tokenRate??'—')}</strong><small>Tokens / min</small></div><div><strong>${esc(o.medianLatency??'—')}</strong><small>Median Latency</small></div></div></div></section>
    <section class="card v3-usage-card"><div class="v3-card-header"><div><h2>Usage & Recovery</h2><p>Usage is scoped to this Local SmartAPI runtime.</p></div><button class="btn small" data-action="billing-tab">Usage & Billing</button></div><div class="v3-usage-grid"><div><span>Total Requests</span><strong>${esc(demoMode?fmtCompact(sv.totalRequests):o.totalRequests)}</strong><small>Selected window</small></div><div><span>Total Tokens</span><strong>${esc(demoMode?fmtCompact(sv.totalTokens):o.totalTokens)}</strong><small>Selected window</small></div><div><span>Estimated Cost</span><strong>${esc(demoMode?sv.estimatedCost:o.estimatedCost)}</strong><small>Ledger-backed</small></div><div><span>Recovered Requests</span><strong>${fmtCompact(sv.recoveredCount||0)}</strong><small>Protected traffic</small></div></div></section>
    <section class="card panel cache-hit-overview"><div class="section-head"><div><h2>Prompt Cache Hit Rate</h2></div><span class="cache-hit-method">Final upstream protocol</span></div><div class="cache-hit-grid"><article class="cache-hit-total"><span>Overall cache hit rate</span><strong>${esc(fmtPct(overallCache.hitRate))}</strong><div class="cache-hit-meter large" role="meter" aria-label="Overall cache hit rate" aria-valuemin="0" aria-valuemax="100" ${overallCache.hitRate===null||overallCache.hitRate===undefined?'aria-valuetext="No input-token usage observed"':`aria-valuenow="${cacheRate.toFixed(2)}"`}><i style="width:${cacheRate.toFixed(2)}%"></i></div><p>${overallCache.hitRate===null||overallCache.hitRate===undefined?'No input-token usage observed.':`${esc(fmtCompact(overallCache.cacheReadTokens))} cached of ${esc(fmtCompact(overallCache.eligibleInputTokens))} eligible input tokens.`}</p><div class="cache-hit-total-meta"><div><strong>${esc(fmtCompact(overallCache.cacheWriteTokens))}</strong><small>Cache writes</small></div><div><strong>${esc(fmtCompact(overallCache.observedRequests))}</strong><small>Observed requests</small></div><div><strong>${esc(fmtCompact(overallCache.requests))}</strong><small>Total requests</small></div></div></article>${cacheHitBreakdown('By API key','Every configured key plus historical keys with traffic.',keyCache)}${cacheHitBreakdown('By logical model','Client-facing model cache efficiency.',modelCache)}</div></section>
    <section class="card panel traffic-trends"><div class="section-head"><div><h2>Traffic Trends</h2></div></div><div class="traffic-chart-grid">${trafficTrendChart('All calls','Every client request, including requests that failed before provider selection.',callSeries)}${trafficTrendChart('Logical model calls','Client-facing model demand and each model’s success rate.',trafficTrends.logicalModels||[])}${trafficTrendChart('Actual provider calls','Final providers that accepted traffic; pre-selection failures are excluded.',trafficTrends.providers||[])}${trafficTrendChart('Actual provider / model calls','Concrete upstream provider and model pairs with their success rates.',trafficTrends.providerModels||[])}</div></section>
    <section class="card panel"><div class="section-head"><div><h2>Recent Runtime Events</h2><p>Latest alerts and automatic recovery activity.</p></div><button class="btn small" data-action="alerts-open">Open alerts</button></div><div class="v3-event-list">${alerts.map(alert=>`<div><span>${badge(alert.state)}</span><span><strong>${esc(alert.title)}</strong><small>${esc(alert.detail||'')}</small></span><button class="btn small" data-action="alert-open-resource" data-kind="${esc(alert.resource_kind)}" data-id="${esc(alert.resource_id)}">Open</button></div>`).join('')||managed.slice(0,3).map(event=>`<div><span>${badge('Recovered')}</span><span><strong>${esc(event.title)}</strong><small>${esc(event.detail)}</small></span></div>`).join('')||'<div class="empty compact-empty">No recent runtime events.</div>'}</div></section>
  </div>`;
}

function requestFilterSummary(){const values=[state.requestLogicalModel&&`Exact logical model ${state.requestLogicalModel}`,state.requestParticipatingProvider&&`Participating provider ${state.requestParticipatingProvider}`,state.requestAttemptStatus&&`Attempt status ${state.requestAttemptStatus}`,state.requestAttemptFailureType&&`Attempt error ${state.requestAttemptFailureType}`,state.requestReportError&&`Client error ${state.requestReportError}`,state.requestConversation&&`Conversation ${state.requestConversation}`,state.requestModel&&`Model ${state.requestModel}`,state.requestProvider&&`Provider ${state.requestProvider}`,state.requestCallerIdentity&&`${nt('Caller','调用方')} ${state.requestCallerIdentity==='__unknown__'?nt('Unknown','未知'):state.apiKeys.find(k=>k.id===state.requestCallerIdentity)?.name||state.requestCallerIdentity}`,state.requestApiKey&&`API Key ${state.requestApiKey}`,state.requestFailureType&&`Failure ${state.requestFailureType}`,state.requestStatus&&`Status ${state.requestStatus}`,state.requestRevision&&`Revision ${state.requestRevision}`,state.requestFrom&&`From ${state.requestFrom}`,state.requestTo&&`To ${state.requestTo}`].filter(Boolean);return values.length?values.join(' · '):'No additional filters';}
function capabilityNames(capabilities){return [['text','text'],['images','images'],['stream','stream'],['tools','tools'],['parallel_tools','parallel tools'],['reasoning','reasoning'],['structured_output','structured output'],['vision','vision'],['priority','Fast (priority)']].filter(([key])=>capabilities?.[key]).map(([,label])=>label)}
function candidateExclusionDetail(exclusion,required){const offered=exclusion.capabilities||{},missing=capabilityNames(Object.fromEntries(Object.entries(required||{}).filter(([key,value])=>value&&!offered[key])));if(Number(required?.min_context||0)>0&&Number(offered.context_window||0)>0&&Number(offered.context_window)<Number(required.min_context))missing.push(`context ${offered.context_window} < ${required.min_context}`);if(Number(required?.min_output||0)>0&&Number(offered.max_output||0)>0&&Number(offered.max_output)<Number(required.min_output))missing.push(`max output ${offered.max_output} < ${required.min_output}`);return [exclusion.reason,missing.length?`Missing: ${missing.join(', ')}`:''].filter(Boolean).join(' · ')}
function requestTimingSegments(events=[]){
 const phases={BODY_RECEIVE_COMPLETED:['BODY_RECEIVE_STARTED','Receive'],BODY_PARSE_COMPLETED:['BODY_PARSE_STARTED','Parse'],PLANNING_COMPLETED:['PLANNING_STARTED','Plan'],COMPATIBILITY_COMPLETED:['COMPATIBILITY_STARTED','Compatibility'],ADMISSION_COMPLETED:['ATTEMPT_STARTED','Queue'],UPSTREAM_FIRST_EVENT:['UPSTREAM_DISPATCHED','First response']};
 const rows=[];
 events.forEach((end,index)=>{const phase=phases[end.type];if(!phase)return;const start=events.slice(0,index).findLast(event=>event.type===phase[0]&&Number(event.attempt||0)===Number(end.attempt||0));const from=Date.parse(start?.at),to=Date.parse(end.at);if(!Number.isFinite(from)||!Number.isFinite(to)||to<from)return;rows.push({label:phase[1],attempt:Number(end.attempt||0),from,to,duration:to-from});});
 return rows.sort((a,b)=>a.from-b.from);
}
function requestTimingWaterfall(r){
 const rows=requestTimingSegments(r.executionEvents),valid=(r.executionEvents||[]).map(e=>Date.parse(e.at)).filter(Number.isFinite),start=Math.min(...valid),end=Math.max(...valid),span=Math.max(1,end-start);
 return `<section class="card panel section"><div class="section-head"><h2>${nt('Timing breakdown','耗时分解')}</h2>${uiHint(nt('Recorded phases','已记录阶段'),nt('Bars use recorded start and end events. Missing phases are omitted; overlapping stages are not additive.','仅使用实际记录的阶段起止事件。缺失阶段不绘制，重叠阶段不能相加。'))}</div>${rows.length?`<div class="table-wrap"><table class="table timing-waterfall"><thead><tr><th>${nt('Phase','阶段')}</th><th>ms ${uiHint('Timeline',nt('Offset from the first recorded event','相对首个已记录事件的偏移'))}</th><th>${nt('Duration','耗时')}</th></tr></thead><tbody>${rows.map(row=>`<tr><td>${esc(nt(row.label,({Receive:'接收',Parse:'解析',Plan:'规划',Compatibility:'能力匹配',Queue:'准入等待','First response':'上游首响应'})[row.label]))}${row.attempt?` · ${row.attempt}`:''}</td><td><div class="timing-track" role="img" aria-label="${esc(`${row.from-start}–${row.to-start} ms`)}"><i style="left:${(row.from-start)/span*100}%;width:${row.duration/span*100}%"></i></div></td><td>${row.duration.toLocaleString()} ms</td></tr>`).join('')}</tbody></table></div>`:`<div class="empty compact-empty">${nt('No complete timing pairs recorded','未记录完整阶段起止时间')}</div>`}${r.eventsTruncated?`<span class="badge orange">${nt('Partial trace','部分事件')}</span>`:''}</section>`;
}
function requestAttemptTable(r){
 const steps=r.routePath||[];
 return `<section class="card panel section"><h2>${nt('Attempt Path','尝试路径')}</h2><div class="table-wrap"><table class="table attempt-table"><thead><tr>${['#','Provider / Upstream Model','Result','First frame','Complete','Tokens','Details'].map(x=>`<th>${x}</th>`).join('')}</tr></thead><tbody>${steps.map((step,index)=>`<tr><td>${index+1}</td><td>${esc(step.provider||'—')}<div class="cell-sub">${esc(step.model||'—')}</div></td><td>${badge(step.status)}${step.failure?`<div class="danger">${esc(step.failure)}</div>`:''}${index?`<small>${steps[index-1].provider===step.provider?nt('Provider retry','渠道内重试'):nt('Provider fallback','渠道回退')}</small>`:''}</td><td>${esc(step.ttft||'—')}</td><td>${esc(step.latency||'—')}</td><td>${esc(step.tokenSummary||step.tokens||'—')}</td><td><details open><summary>${icon('info')} ${nt('Details','详情')}</summary><dl>${[['Returned Model',step.responseModel],['Protocol',step.protocol],['Requested service tier',step.serviceTier],['Returned service tier',step.responseServiceTier],['Cache',step.cacheSummary],['Plan',step.planKind],['Pricing version',step.rateCardVersion]].map(([label,value])=>`<dt>${label}</dt><dd>${esc(value||'—')}</dd>`).join('')}</dl></details></td></tr>`).join('')||`<tr><td colspan="7">${nt('No attempt path recorded.','未记录尝试路径。')}</td></tr>`}</tbody></table></div></section>`;
}
function pageRequestDetail(id){
  const failure=detailFailure('requests',id);if(failure)return failure;
  const r=requestDataSync(id);
  if(!r){queueMicrotask(()=>loadAndRenderRequest(id));return `<div class="empty"><strong>Loading request…</strong></div>`}
  if(!state.requestCache.has(id)||!r.trace)queueMicrotask(()=>loadAndRenderRequest(id));
  queueMicrotask(()=>decorateRequestConversationTrigger(r));
  const trace=r.trace||[],routePath=r.routePath||[],exclusions=r.raw?.exclusions||[],debug=r.debug,usageValue=value=>r.usageObserved?fmtCompact(value):'—';
  const traceMarkup=trace.map(t=>`<details class="trace-event ${esc(t.kind)}" open><summary><time>${esc(t.time)}</time><strong>${esc(t.title)}</strong><span class="trace-duration">${esc(t.latency)}</span></summary><div class="trace-detail ${esc(t.kind)}">${esc(t.sub)}</div></details>`).join('')||'<div class="empty compact-empty"><strong>No trace events recorded</strong></div>';
  return `<div class="page-head"><div class="head-main"><div class="head-line"><button class="btn icon" data-action="requests-page">←</button><h1 class="long-id">Request ${esc(r.id)}</h1>${badge(r.live?r.result:r.canceled?'Canceled':r.failed?'Failed':r.recovered?'Success (Recovered)':'Success')}</div>${requestKeySubtitle(r.apiKey)}</div></div><div class="model-summary request-model-summary"><div class="summary-chip"><strong>${esc(r.logicalModel||r.model)}</strong><small>Logical Model</small></div><div class="summary-chip request-provider-model"><strong>${esc(r.provider||r.providerId||'—')}</strong><small>Provider</small><div><strong>${esc(r.upstreamModel||'—')}</strong><small>Upstream Model</small><strong>${esc(r.responseModel||'—')}</strong><small>Returned Model</small></div></div><div class="summary-chip"><strong>${esc(r.streamMode||'—')}</strong><small>Response Mode</small></div><div class="summary-chip"><strong>${esc(r.ttft||'—')}</strong><small>First Frame / TTFT</small></div><div class="summary-chip"><strong>${esc(r.live?r.elapsedDuration||'—':r.totalDuration||r.latency)}</strong><small>${r.live?nt('Elapsed','已耗时'):nt('Complete Response','完成耗时')}</small></div><div class="summary-chip"><strong>${esc(r.tokenSummary||r.tokens)}</strong><small>Input / Output Tokens</small></div><div class="summary-chip"><strong>${Number.isFinite(r.tokensPerSecond)?r.tokensPerSecond.toFixed(1):'—'}</strong><small>tokens/s</small></div><div class="summary-chip cache-summary-chip"><strong>${esc(r.cacheSummary||'—')}</strong><small>Prompt Cache</small></div><div class="summary-chip request-conversation-summary"><strong class="mono">${esc(r.conversation)}</strong><small>Conversation</small></div><div class="summary-chip"><strong>${esc(r.apiKey)}</strong><small>API Key</small></div></div>${r.failureMessage?`<div class="notice red" role="status">${esc(r.failureMessage)}</div>`:r.recovered?`<div class="notice orange">${nt("Recovered after retry or fallback","已通过重试或回退恢复")}</div>`:''}${requestTimingWaterfall(r)}${requestAttemptTable(r)}<div class="grid-2 section"><details class="card panel" open><summary>Execution Trace · ${trace.length}</summary><div class="trace collapsible-trace">${traceMarkup}</div></details><div class="stack"><section class="card panel"><h2>Cost & Pricing</h2>${requestCostDetails(r,true)}${uiHint("Historical pricing","Exact unit rates are not retained on old attempt records.")}</section><details class="card panel" open><summary>Candidate Exclusions · ${exclusions.length}</summary>${exclusions.map((x,index)=>`<div class="split-event"><div><strong>${esc(x.provider_id||`Provider candidate ${index+1}`)} · ${esc(x.upstream_model||'Unknown model')}</strong><div class="cell-sub">${esc(x.connection_id||'Unknown connection')}</div></div><span>${esc(candidateExclusionDetail(x,r.requiredCapabilities))}</span></div>`).join('')||'<div class="empty compact-empty">No candidates were excluded.</div>'}</details><details class="card panel" open><summary>Structured Runtime</summary>${[['Result',r.result],['Requested service tier',r.serviceTier||'—'],['Returned service tier',r.responseServiceTier||'—'],['Response mode',r.streamMode||'—'],['Required capabilities',capabilityNames(r.requiredCapabilities).map(name=>({'text':nt('text','文本'),'images':nt('images','图像'),'stream':nt('stream','流式'),'tools':nt('tools','工具调用'),'parallel tools':nt('parallel tools','并行工具调用'),'reasoning':nt('reasoning','推理'),'structured output':nt('structured output','结构化输出'),'vision':nt('vision','视觉')})[name]||name).join(', ')||nt('text','文本')],['First frame / TTFT',r.ttft||'—'],[r.live?nt('Elapsed','已耗时'):'Complete response',r.live?r.elapsedDuration||'—':r.totalDuration||r.latency],['Input tokens',usageValue(r.inputTokens)],['Output tokens',usageValue(r.outputTokens)],['Cache read tokens',usageValue(r.cacheReadTokens)],['Cache write tokens',usageValue(r.cacheWriteTokens)],['Reasoning tokens',usageValue(r.reasoningTokens)],['Attempts',r.attempts],['Provider fallbacks',r.providerFallbacks??'—'],['Conversation rebind',r.conversationRebind==='Yes'?nt('Yes','是'):r.conversationRebind==='No'?nt('No','否'):r.conversationRebind??'—'],['Recovery overhead',r.recoveryOverhead??'—'],['Runtime revision',r.runtimeRevision??'—'],['Protocol',r.raw?.protocol||'—'],['Continuity',r.raw?.continuity_mode||'—'],['Failure type',r.raw?.failure_type||'—'],['Failure message',r.failureMessage||'—']].map(x=>`<div class="inline request-runtime-row"><span class="cell-sub">${x[0]}</span><strong>${esc(x[1])}</strong></div>`).join('')}</details></div></div>${debug?`<div class="grid-2 section"><section class="card panel debug-panel"><div class="section-head"><div><h2>Debug Request</h2><p>${debug.request_truncated?'Truncated at 256 KB':'Captured when the request began'}</p></div><button class="btn small" data-action="copy-debug" data-side="request" data-id="${esc(r.id)}">Copy</button></div><pre>${esc(prettyDebug(debug.request))}</pre></section><section class="card panel debug-panel"><div class="section-head"><div><h2>Debug Response</h2><p>${debug.response_truncated?'Truncated at 256 KB':'Aggregated final response'}</p></div><button class="btn small" data-action="copy-debug" data-side="response" data-id="${esc(r.id)}">Copy</button></div><pre>${esc(prettyDebug(debug.response))}</pre></section></div>`:`<div class="section"><span class="cell-sub">No debug payload was recorded</span> ${uiHint("Request Debug","Enable Request Debug in Settings before sending a request. The setting applies only to new requests.")}</div>`}`
}
function requestKeySubtitle(name){return name&&name!=="—"?`<small class="cell-sub request-key-subtitle">${nt('API Key','API 密钥')} · ${esc(name)}</small>`:''}
function requestMoney(value){return Number.isFinite(Number(value))?new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',minimumFractionDigits:4,maximumFractionDigits:6}).format(Number(value)):'—'}
function requestPricingLabel(ref){return ({catalog_unavailable:'Waiting for price sync',model_not_found:'Model not in catalog',ambiguous_model:'Multiple catalog providers',usage_unavailable:'Usage unavailable',cache_price_missing:'Cache rate not listed'})[ref?.status]||'Price unavailable'}
function requestReferenceDetails(ref){
  if(!ref)return '<p>No reference catalog snapshot available.</p>';
  const rate=value=>value==null?'Not listed':esc(requestMoney(value)),rates=ref.rates;
  return `<div class="request-reference-details"><h3>Current reference price</h3><p>Standard text-token estimate in USD, excluding tools, media, service-tier adjustments and recovery attempts. It is not the subscription charge or the historical bill.</p>${rates?`${[['Input / 1M',rates.input_per_m],['Output / 1M',rates.output_per_m],['Cache read / 1M',rates.cache_read_per_m],['Cache write / 1M',rates.cache_write_per_m]].map(([label,value])=>`<span><small>${label}</small><b>${rate(value)}</b></span>`).join('')}<span><small>Reference estimate</small><b>${ref.cost==null?esc(requestPricingLabel(ref)):esc(requestMoney(ref.cost))}</b></span>`:`<p>${esc(requestPricingLabel(ref))}</p>`}<p>${esc(ref.source||'Catalog')} · ${esc(ref.provider||'—')} · ${esc(ref.model||'—')}<br>${esc(ref.version||'No snapshot')}<br>Updated ${ref.updated_at&&!ref.updated_at.startsWith('0001-')?esc(new Date(ref.updated_at).toLocaleString()):'—'}${ref.stale?' · Cached / awaiting refresh':''}${ref.tier_above_input_tokens?` · Above ${Number(ref.tier_above_input_tokens).toLocaleString('en-US')} input tokens`:''}</p></div>`;
}
function requestCostDetails(r,expanded=false){
  const raw=r.raw||{},observed=raw.cost_observed===true;
  return `<details ${expanded?'open':''} class="request-cost-details" data-action="request-cost-details"><summary>USD · Cost & pricing</summary><div><p>Recorded estimates in USD. Missing prices do not mean free usage.</p>${[['Total',observed?raw.total_cost:null],['PAYG estimate',observed?raw.estimated_cash_cost:null],['Subscription allocation',observed?raw.allocated_sub_cost:null],['Serving',observed?raw.serving_cost:null],['Recovery overhead',observed?raw.recovery_overhead_cost:null],['Recorded reference token value',raw.shadow_cost||null]].map(([label,value])=>`<span><small>${label}</small><b>${value==null?'—':esc(requestMoney(value))}</b></span>`).join('')}<p>Total includes serving and recovery, with the legacy cash fallback. Subscription allocation is included in those amounts.</p>${requestReferenceDetails(raw.reference_pricing)}<a href="#/requests/${encodeURIComponent(r.id)}">View attempts and pricing versions →</a></div></details>`;
}
// Visual speed bands: TTFT uses 5/10s; total uses 30/15 tokens per second
// for at least 100 output tokens, otherwise 10/30s. Each metric is independent.
function requestTimingTone(milliseconds,outputTokens,firstToken=false){
  const seconds=Number(milliseconds)/1000;
  if(!Number.isFinite(seconds)||seconds<=0)return 'unknown';
  if(firstToken)return seconds<5?'fast':seconds<10?'moderate':'slow';
  if(Number(outputTokens)>=100){const tps=Number(outputTokens)/seconds;return tps>=30?'fast':tps>=15?'moderate':'slow'}
  return seconds<10?'fast':seconds<30?'moderate':'slow';
}
function requestAccountingCells(r){
  const count=value=>r.usageObserved?Number(value||0).toLocaleString('en-US'):'—',raw=r.raw||{},ref=raw.reference_pricing;
  const eligible=Number(raw.cache_eligible_input_tokens),read=Math.max(0,Number(r.cacheReadTokens)||0),percent=r.usageObserved&&eligible>0?`${Math.min(100,read/eligible*100).toFixed(1)}%`:'—';
  const firstTone=requestTimingTone(raw.ttft_ms,r.outputTokens,true),totalTone=r.live?'':requestTimingTone(raw.duration_ms,r.outputTokens);
  const observed=raw.cost_observed===true,estimated=!observed&&ref?.cost!=null,rates=ref?.rates;
  const priceLabel=rates?`$${Number(rates.input_per_m).toLocaleString('en-US')} / $${Number(rates.output_per_m).toLocaleString('en-US')} / 1M`:requestPricingLabel(ref);
  return `<td class="request-token-cell"><strong class="mono">${count(r.inputTokens)} / ${count(r.outputTokens)}</strong><small>Cache ↓ ${count(r.cacheReadTokens)} · ${percent}</small><small>${Number.isFinite(r.tokensPerSecond)?r.tokensPerSecond.toFixed(1):'—'} tokens/s</small></td><td class="request-money-cell"><span class="request-cost-pill">${observed?esc(requestMoney(raw.total_cost)):estimated?`≈ ${esc(requestMoney(ref.cost))}`:'—'}</span><small class="cell-sub">${observed?'Recorded':estimated?'Reference estimate':'No recorded cost'}</small></td><td class="request-timing-cell"><div class="request-timing-metric ${firstTone}"><small>First token</small><strong>${esc(r.ttft||'—')}</strong></div><div class="request-timing-metric ${totalTone}"><small>${r.live?nt('Elapsed','已耗时'):nt('Total','总计')}</small><strong>${esc(r.live?r.elapsedDuration||'—':r.totalDuration||r.latency||'—')}</strong></div></td><td class="request-price-cell request-optional"><button class="btn small" data-action="show-request-cost" data-id="${esc(r.id)}">${esc(priceLabel)}</button><small class="cell-sub">${rates?`Reference · ${esc(ref.source)}${ref.stale?' · Cached':''}`:'Cost details'}</small></td>`;
}
function pageRequests(){
  const list=state.requests,pages=Math.max(1,Math.ceil(state.requestTotal/state.requestLimit)),page=Math.floor(state.requestOffset/state.requestLimit)+1;
  const advancedActive=Boolean(state.requestFrom||state.requestTo||state.requestApiKey||state.requestFailureType||state.requestStatus||state.requestRevision);
  queueMicrotask(decorateRequestWindowOptions);
  return `${state.requestError?`<div class="notice red" role="alert"><strong>${state.requestError.stale?'Refresh failed · previous snapshot':'Query failed'}</strong><span>${esc(state.requestError.message)}</span><button class="btn" data-action="request-refresh">Retry</button></div>`:''}<div class="page-head requests-page-head"><div class="head-main"><h1>Requests</h1>${state.reportOrigin?`<button class="btn small" data-next="report-return">${nt('Back to report','返回报表')}</button>`:''}<p>${esc(state.requestTotal)} ${nt('matching requests','条匹配请求')}</p></div><div class="head-actions"><button class="btn" data-action="request-export" data-format="json" ${state.requestExporting?'disabled':''}>${state.requestExporting?'Exporting…':'Export all JSON'}</button><button class="btn" data-action="request-export" data-format="csv" ${state.requestExporting?'disabled':''}>${state.requestExporting?'Exporting…':'Export all CSV'}</button></div></div><section class="card request-filter-card"><div class="request-primary-filters"><select class="select" aria-label="Time window" data-action="request-window"><option value="15m" ${state.requestWindow==='15m'?'selected':''}>15 min</option><option value="1h" ${state.requestWindow==='1h'?'selected':''}>1 hour</option><option value="24h" ${state.requestWindow==='24h'?'selected':''}>24 hours</option></select><select class="select" aria-label="Logical model" data-action="request-model"><option value="">All Models</option>${state.models.map(x=>`<option value="${esc(x.id)}" ${state.requestModel===x.id?'selected':''}>${esc(x.id)}</option>`).join('')}</select><select class="select" aria-label="Provider" data-action="request-provider"><option value="">All Providers</option>${state.providers.map(x=>`<option value="${esc(x.id)}" ${state.requestProvider===x.id?'selected':''}>${esc(x.name)}</option>`).join('')}</select><select class="select" aria-label="Outcome" data-action="request-filter"><option value="all" ${state.requestFilter==='all'?'selected':''}>All Outcomes</option><option value="recovered" ${state.requestFilter==='recovered'?'selected':''}>Recovered</option><option value="received" ${state.requestFilter==='received'?'selected':''}>Received</option><option value="waiting" ${state.requestFilter==='waiting'?'selected':''}>Waiting</option><option value="active" ${state.requestFilter==='active'?'selected':''}>Active</option><option value="recovering" ${state.requestFilter==='recovering'?'selected':''}>Recovering</option><option value="streaming" ${state.requestFilter==='streaming'?'selected':''}>Streaming</option><option value="delivering" ${state.requestFilter==='delivering'?'selected':''}>Delivering</option><option value="direct" ${state.requestFilter==='direct'?'selected':''}>Direct</option><option value="failed" ${state.requestFilter==='failed'?'selected':''}>Failed</option><option value="canceled" ${state.requestFilter==='canceled'?'selected':''}>Canceled</option></select><input class="input request-search" aria-label="Search requests" data-input="request-search" value="${esc(state.requestSearchDraft??state.requestSearch)}" placeholder="Request / conversation / API key"><button class="btn" data-action="request-clear">Clear filters</button><button class="btn primary request-search-submit" data-action="request-search-submit">${icon('search')} Search</button></div><details class="request-advanced" ${advancedActive?'open':''}><summary><span>Advanced filters</span><span class="cell-sub">Exact time, API key, failure and revision</span></summary><div class="request-toolbar"><label class="filter-field"><span>From</span><input class="input" type="datetime-local" data-action="request-from" step="0.001" value="${esc(requestLocalTime(state.requestFrom))}"></label><label class="filter-field"><span>To</span><input class="input" type="datetime-local" data-action="request-to" step="0.001" value="${esc(requestLocalTime(state.requestTo))}"></label><label class="filter-field"><span>API Key</span><select class="select" data-action="request-api-key"><option value="">All API Keys</option>${state.apiKeys.map(x=>`<option value="${esc(x.name)}" ${state.requestApiKey===x.name?'selected':''}>${esc(x.name)}</option>`).join('')}</select></label><label class="filter-field"><span>Failure type</span><input class="input" data-action="request-failure" value="${esc(state.requestFailureType)}" placeholder="Any failure"></label><label class="filter-field"><span>Status</span><input class="input" data-action="request-status" value="${esc(state.requestStatus)}" placeholder="Any status"></label><label class="filter-field"><span>Runtime revision</span><input class="input" inputmode="numeric" data-action="request-revision" value="${esc(state.requestRevision)}" placeholder="Any revision"></label></div></details></section><div class="filter-summary"><span>${esc(requestFilterSummary())}</span><span role="status" data-request-query-pending>${state.requestSearchDraft!==undefined&&state.requestSearchDraft!==state.requestSearch?nt('Search not applied','搜索尚未应用'):''}</span><label class="auto-refresh"><input type="checkbox" data-action="request-columns" ${state.requestColumns?'checked':''}> ${nt('Extra columns','更多列')}</label><label class="auto-refresh"><input type="checkbox" data-action="request-auto" ${state.requestAutoRefresh?'checked':''}> Auto refresh · 3s</label><span role="status">${state.requestLoading?'Updating requests…':`Updated ${esc(state.requestLastUpdated?state.requestLastUpdated.toLocaleTimeString():'—')}`}</span></div><section class="card table-wrap fade-edge" aria-busy="${state.requestLoading}"><table class="table requests-table ${state.requestColumns?'':'request-compact'}"><thead><tr><th>Time</th><th>Request ID</th><th>Logical Model</th><th class="request-optional">Conversation</th><th>Provider / Upstream Model</th><th>Result</th><th class="request-optional">Mode</th><th>Tokens · In / Out</th><th>Cost · USD</th><th>Timing</th><th class="request-optional">Details</th></tr></thead><tbody>${list.map(r=>`<tr class="clickable" tabindex="0" role="link" data-action="open-request" data-id="${esc(r.id)}"><td>${esc(r.time)}</td><td class="link mono long-id" title="${esc(r.id)}">${typeof requestObservationPrefix==='function'?requestObservationPrefix(r):''}${esc(r.id.length>16?r.id.slice(0,8)+'…'+r.id.slice(-5):r.id)}${requestKeySubtitle(r.apiKey)}</td><td>${esc(r.model)}</td><td class="mono long-id request-optional">${esc(r.conversation)}</td><td><div class="cell-title">${esc(r.providerId||r.provider||r.route||'—')}</div><div class="cell-sub">${esc(r.upstreamModel||'—')}</div></td><td>${badge(r.live?r.result:r.canceled?'Canceled':r.failed?'Failed':r.recovered?'Recovered':r.raw?.outcome==='DIRECT_SUCCESS'?'Direct':'Success')}</td><td class="request-optional">${esc(r.streamMode||'—')}</td>${requestAccountingCells(r)}</tr>`).join('')||'<tr><td colspan="11"><div class="empty compact-empty"><strong>No matching requests</strong>Clear filters or widen the window.</div></td></tr>'}</tbody></table></section><div class="pagination"><button class="btn" data-action="request-page" data-offset="${Math.max(0,state.requestOffset-state.requestLimit)}" ${page<=1||state.requestLoading?'disabled':''}>Previous</button><span>Page ${page} / ${pages}</span><select class="select" aria-label="Requests per page" data-action="request-limit" ${state.requestLoading?'disabled':''}>${[25,50,100].map(x=>`<option ${state.requestLimit===x?'selected':''}>${x}</option>`).join('')}</select><button class="btn" data-action="request-page" data-offset="${state.requestOffset+state.requestLimit}" ${page>=pages||state.requestLoading?'disabled':''}>Next page</button></div>`;
}

function keyWindowLabel(){return ({'24h':nt('Last 24 hours','近 24 小时'),'168h':nt('Last 7 days','近 7 天'),'720h':nt('Last 30 days','近 30 天')})[state.keyWindow||'168h']}
function keyNumber(value){return value==null?'—':new Intl.NumberFormat(consoleLocale,{notation:'compact',maximumFractionDigits:1}).format(value)}
function keyTokenTotal(k){const u=k.usageSummary;return u&&(u.tokens_observed||u.requests===0)?Number(u.input_tokens||0)+Number(u.output_tokens||0):null}
function keyLastUsed(k){return [k.lastRequestAt,...(k.secrets||[]).map(s=>s.last_used_at)].filter(v=>Number.isFinite(Date.parse(v))).sort((a,b)=>Date.parse(b)-Date.parse(a))[0]||null}
function keyLastUsedLabel(k){const last=keyLastUsed(k);if(!last)return nt('No recorded use','未记录使用');const elapsed=Math.max(0,Date.now()-Date.parse(last)),units=elapsed<3600000?['minute',60000]:elapsed<86400000?['hour',3600000]:['day',86400000];return elapsed<60000?nt('Just now','刚刚'):new Intl.RelativeTimeFormat(consoleLocale,{numeric:'auto'}).format(-Math.floor(elapsed/units[1]),units[0])}
function keyCoverageHint(k){const c=k?.history?.coverage;if(!c)return nt('History coverage is unavailable.','历史覆盖范围暂不可用。');const gap=Number(c.rollup_only_requests)>0||Number(c.mismatched_hours)>0;return (gap?nt('Partial history: retained request details only. Global hourly totals show gaps; missing records cannot be assigned to individual keys.','历史不完整：仅统计保留的请求明细。全局小时汇总存在差异，缺失记录无法分配到各密钥。'):nt('Based on retained request details. Older deleted history cannot be reconstructed per key.','基于保留的请求明细；已删除的旧历史无法按密钥还原。'))+(c.earliest_detail?' '+nt('Earliest retained request: ','最早保留请求：')+new Date(c.earliest_detail).toLocaleString(consoleLocale):'')}
function keySuccess(k){const u=k.usageSummary;return u?.requests>0&&u.succeeded!=null?(100*u.succeeded/u.requests).toFixed(1)+'%':'—'}
function keyTokenHint(k){const u=k.usageSummary||{},count=k.history?.tokens_observed_requests;return `${nt('Input','输入')} ${u.tokens_observed||u.requests===0?Number(u.input_tokens||0).toLocaleString(consoleLocale):'—'} / ${nt('Output','输出')} ${u.tokens_observed||u.requests===0?Number(u.output_tokens||0).toLocaleString(consoleLocale):'—'}`+(count!=null?` · ${nt('Requests with token evidence','有 Token 记录的请求')} ${count}/${u.requests??'—'}`:'')+' · '+nt('Only recorded usage is included; partial observations may undercount.','仅统计已记录的用量；部分记录可能不完整。')}
function keyUsageHint(k){const u=k.usageSummary||{};return `${nt('Succeeded','成功')} ${u.succeeded??'—'} · ${nt('Failed','失败')} ${u.failed??'—'} · ${nt('Canceled','已取消')} ${u.canceled??'—'}`}
function keyTrend(k,large=false){
 const bins=k.history?.timeline;if(!Array.isArray(bins)||!bins.length)return `<span class="muted">${nt('Unavailable','暂不可用')}</span>`;
 const w=large?640:120,h=large?130:28,p=large?8:3,max=Math.max(1,...bins.map(b=>Number(b.requests)||0)),step=(w-2*p)/bins.length;
 const point=(b,i)=>[p+step*(i+.5),h-p-(Number(b.requests)||0)/max*(h-2*p)];
 const points=bins.map((b,i)=>point(b,i).join(',')).join(' ');
 const label=nt('Request history','请求历史');
 return `<svg class="key-trend ${large?'key-trend-large':''}" viewBox="0 0 ${w} ${h}" role="img" aria-label="${esc(label)}"><title>${esc(label)}</title><path d="M${p} ${h-p}H${w-p}" class="key-trend-baseline"/>${large?bins.map((b,i)=>{const [x,y]=point(b,i);return `<rect x="${x-step*.34}" y="${y}" width="${step*.68}" height="${Math.max(0,h-p-y)}" rx="2" class="key-trend-bar"/>`}).join(''):`<polyline points="${points}" class="key-trend-line"/>`}${bins.map((b,i)=>{const label=`${new Date(b.from).toLocaleString(consoleLocale)} – ${new Date(b.to).toLocaleString(consoleLocale)} · ${nt('Requests','请求')} ${b.requests} · ${nt('Input','输入')} ${b.tokens_observed||!b.requests?b.input_tokens??0:'—'} · ${nt('Output','输出')} ${b.tokens_observed||!b.requests?b.output_tokens??0:'—'}`;return `<g tabindex="0" data-tooltip="${esc(label)}" data-tooltip-literal aria-label="${esc(label)}"><rect x="${p+i*step}" y="0" width="${step}" height="${h}" class="key-trend-hit"/><title>${esc(label)}</title></g>`}).join('')}</svg>`;
}
function sortedApiKeys(){
 const q=(state.keySearch||'').toLowerCase(),field=state.keySort||'last',descending=state.keySortDescending!==false;
 const value=k=>field==='requests'?(k.usageSummary?.requests??null):field==='tokens'?keyTokenTotal(k):keyLastUsed(k)?Date.parse(keyLastUsed(k)):null;
 return state.apiKeys.filter(k=>(!q||k.name.toLowerCase().includes(q)||k.scope.toLowerCase().includes(q))&&(!state.keyStatus||k.status===state.keyStatus)).slice().sort((a,b)=>{const x=value(a),y=value(b);if(x==null||y==null)return x==null&&y==null?a.name.localeCompare(b.name):x==null?1:-1;return (descending?y-x:x-y)||a.name.localeCompare(b.name)});
}
async function reloadApiKeyHistory(window='168h'){
 if(!['24h','168h','720h'].includes(window))return;
 const generation=state.keyGeneration=(state.keyGeneration||0)+1,epoch=state.sessionEpoch;
 state.keyWindow=window;state.keyLoading=true;state.keyError='';render();
 try{const keys=await adapter.getApiKeys(window);if(generation!==state.keyGeneration||epoch!==state.sessionEpoch)return;state.apiKeys=keys;}
 catch(error){if(generation!==state.keyGeneration||epoch!==state.sessionEpoch)return;state.keyError=error.message;}
 finally{if(generation===state.keyGeneration&&epoch===state.sessionEpoch){state.keyLoading=false;render()}}
}
async function openApiKeyHistory(id){
 const pending={type:'api-key-loading',id};state.modal=pending;renderPortal();
 try{const key=await adapter.getApiKey(id,state.keyWindow||'168h');if(state.modal!==pending)return;state.modal={type:'api-key-detail',key};renderPortal()}
 catch(error){if(state.modal!==pending)return;state.modal=null;renderPortal();showToast(error.message,'error')}
}
function pageApiKeys(){
 const list=sortedApiKeys(),header=(label,sort)=>`<th${sort?` aria-sort="${(state.keySort||'last')===sort?(state.keySortDescending===false?'ascending':'descending'):'none'}"`:''}>${sort?`<button class="key-sort" data-action="key-sort" data-sort="${sort}">${label}${icon((state.keySort||'last')===sort&&state.keySortDescending===false?'up':'down')}</button>`:label}</th>`;
 const rows=list.map(k=>{const keyEnabled=k.identity?.enabled??k.status==='Active',canUse=k.status!=='Revoked',u=k.usageSummary,observed=keyTokenTotal(k)!=null,last=keyLastUsed(k),gap=Number(k.history?.coverage?.rollup_only_requests)>0||Number(k.history?.coverage?.mismatched_hours)>0;return `<tr>
 <td class="key-history-name" data-label="Name"><button class="link-button cell-title" data-action="open-key" data-id="${esc(k.id)}" data-i18n-skip>${esc(k.name)}</button><div class="key-credential"><span class="mono" data-i18n-skip>${esc(k.preview)}</span>${canUse?`${uiAction('eye',nt('Reveal full API key','显示完整密钥'),'reveal-key',{id:k.id})}${uiAction('copy',nt('Copy API key','复制密钥'),'copy-stored-key',{id:k.id})}`:''}</div></td>
 <td data-label="Status">${badge(k.status)}</td><td class="key-history-access" data-label="Access"><span data-tooltip="${esc(k.scope)}" data-tooltip-literal tabindex="0">${esc(k.scope)}</span></td>
 <td data-label="${nt('Request count','请求数')}"><div class="key-request-total"><strong>${keyNumber(u?.requests)}</strong>${gap?uiHint(nt('History coverage','历史覆盖范围'),keyCoverageHint(k),'warning'):''}</div>${keyTrend(k)}</td>
 <td data-label="Token"><div class="key-token-pair" data-tooltip="${esc(keyTokenHint(k))}" tabindex="0"><span>↓ ${observed?keyNumber(u?.input_tokens||0):'—'}</span><span>↑ ${observed?keyNumber(u?.output_tokens||0):'—'}</span></div></td>
 <td data-label="${nt('Success rate','成功率')}"><span data-tooltip="${esc(keyUsageHint(k))}" data-tooltip-literal tabindex="0">${keySuccess(k)}</span></td>
 <td data-label="Last used"><span data-tooltip="${esc(last?new Date(last).toLocaleString(consoleLocale):nt('No activity in retained records or credential metadata.','保留记录及凭据元数据中没有使用记录。'))}" data-tooltip-literal tabindex="0">${esc(keyLastUsedLabel(k))}</span></td>
 <td data-label="Actions"><div class="key-history-actions">${uiAction('chart',nt('Usage details','用量详情'),'open-key',{id:k.id})}<details class="v3-more-menu api-key-more"><summary class="btn small ui-action" aria-label="${nt('More actions','更多操作')}" data-tooltip="${nt('More actions','更多操作')}">${icon('more')}</summary><div class="v3-more-popover">${canUse?`<button data-action="edit-key-policy" data-id="${esc(k.id)}">${k.status==='Expired'?'Edit expiry':'Access & Limits'}</button><button data-action="rotate-key" data-id="${esc(k.id)}">Change Key</button><button data-action="toggle-key" data-id="${esc(k.id)}" data-enabled="${!keyEnabled}">${keyEnabled?'Disable':'Enable'}</button><button class="danger" data-action="revoke-key" data-id="${esc(k.id)}">Revoke permanently</button>`:`<button class="danger" data-action="delete-key" data-id="${esc(k.id)}">Delete metadata</button>`}</div></details></div></td></tr>`}).join('');
 return `<div class="page-head"><div class="head-main"><h1>API Keys</h1></div><button class="btn primary" data-action="create-key">${icon('plus')} Create API Key</button></div><div class="toolbar key-history-toolbar"><input class="input" data-input="key-search" value="${esc(state.keySearch)}" placeholder="Search API keys…"><select class="input" data-action="key-status" aria-label="${nt('Key status','密钥状态')}"><option value="">${nt('All statuses','全部状态')}</option>${['Active','Disabled','Expired','Revoked'].map(v=>`<option value="${v}" ${state.keyStatus===v?'selected':''}>${esc(v)}</option>`).join('')}</select><div class="key-window-tabs" role="group" aria-label="${nt('History period','统计周期')}">${[['24h',nt('24 hours','24 小时')],['168h',nt('7 days','7 天')],['720h',nt('30 days','30 天')]].map(([v,label])=>`<button class="btn small ${(state.keyWindow||'168h')===v?'active':''}" data-action="key-window" data-window="${v}" aria-pressed="${(state.keyWindow||'168h')===v}">${label}</button>`).join('')}</div>${uiHint(nt('History coverage','历史覆盖范围'),keyCoverageHint(state.apiKeys[0]))}${uiAction('refresh',nt('Refresh','刷新'),'key-refresh',{},state.keyLoading)}</div><section class="card key-history-wrap" aria-busy="${Boolean(state.keyLoading)}"><table class="table key-history-table"><thead><tr>${header(nt('Name / key','名称 / 密钥'))}${header(nt('Status','状态'))}${header(nt('Access','权限'))}${header(nt('Requests','请求数'),'requests')}${header('Token ↓ / ↑','tokens')}${header(nt('Success rate','成功率'))}${header(nt('Last used','最近使用'),'last')}${header(nt('Actions','操作'))}</tr></thead><tbody>${state.keyLoading?`<tr><td colspan="8" class="empty">${nt('Loading history…','正在加载历史…')}</td></tr>`:state.keyError?`<tr><td colspan="8" class="empty">${esc(state.keyError)} ${uiAction('refresh',nt('Retry','重试'),'key-refresh')}</td></tr>`:rows||`<tr><td colspan="8" class="empty">${nt('No matching API keys','没有匹配的密钥')}</td></tr>`}</tbody></table></section>`;
}
function apiKeyHistoryDetail(k){const bins=k.history?.timeline||[],models=(k.history?.models||[]).slice().sort((a,b)=>b.requests-a.requests),max=Math.max(1,...models.map(m=>m.requests));return `<div class="section key-history-detail"><div class="key-section-head"><h3>${nt('Request history','请求历史')}</h3>${uiHint(nt('History coverage','历史覆盖范围'),keyCoverageHint(k))}</div>${keyTrend(k,true)}${bins.length?`<div class="key-chart-axis"><span>${esc(new Date(bins[0].from).toLocaleDateString(consoleLocale))}</span><span>${esc(new Date(bins.at(-1).to).toLocaleDateString(consoleLocale))}</span></div>`:''}</div><div class="section"><h3>${nt('Model distribution','模型分布')}</h3><div class="key-models">${models.map(m=>`<div class="key-model-row"><span class="mono" data-i18n-skip>${esc(m.id||nt('Unassigned','未分配'))}</span><div class="key-model-track"><i style="width:${Math.max(0,Math.min(100,m.requests/max*100))}%"></i></div><strong>${keyNumber(m.requests)}</strong></div>`).join('')||`<span class="muted">${nt('No requests in this period.','所选时间段内没有请求。')}</span>`}</div></div>`}

function apiKeySecretActivity(key,secret){if(secret.last_used_at)return new Date(secret.last_used_at).toLocaleString();if(secret.state==='ACTIVE'&&key.lastRequestAt)return `${new Date(key.lastRequestAt).toLocaleString()} (key-level activity)`;return 'never recorded'}
function apiKeyDetailModal(modal){const k=modal.key,usage=k.usageSummary||{},recent=k.recentRequests||[],canReveal=k.status!=='Revoked';return `<div class="modal-backdrop" data-action="close-overlay"><div class="modal api-key-detail" data-modal-stop><div class="modal-head"><div><h2>${esc(k.name)}</h2><div class="cell-sub">${esc(k.preview)} · ${esc(k.status)} · ${esc(keyWindowLabel())}</div></div><button class="btn icon ghost" data-action="close-overlay">×</button></div><div class="modal-body"><div class="grid-equal"><div class="summary-chip"><strong>${esc(usage.requests??'—')}</strong><small>Requests</small></div><div class="summary-chip"><strong>${esc(usage.failed??'—')}</strong><small>Failures</small></div><div class="summary-chip"><strong>${esc(usage.tokens_observed||usage.requests===0?Number(usage.input_tokens||0)+Number(usage.output_tokens||0):nt('Unavailable','暂不可用'))}</strong><small>Tokens</small></div><div class="summary-chip"><strong>${esc(usage.cost_observed?usage.total_cost:usage.requests===0?0:nt('Not recorded','未记录'))}</strong><small>Cost</small></div></div>${apiKeyHistoryDetail(k)}<div class="section"><h3>Credential lifecycle</h3>${k.secrets.map(s=>`<div class="split-event"><div><strong class="mono">${esc(s.preview)}</strong><div class="cell-sub">Created ${esc(new Date(s.created_at).toLocaleString())} · Last activity ${esc(apiKeySecretActivity(k,s))}</div></div>${badge(s.state)}${s.state==='GRACE'?`<button class="btn small danger" data-action="retire-key-secret" data-key="${esc(k.id)}" data-id="${esc(s.id)}">Retire</button>`:''}</div>`).join('')||'<div class="empty">No secret metadata.</div>'}</div><div class="section"><h3>Recent requests</h3>${recent.map(r=>`<button class="revision-row revision-button" data-action="open-request" data-id="${esc(r.id)}"><span class="mono long-id">${esc(r.id)}</span><strong>${esc(r.logical_model_id||r.model||'—')}</strong>${badge(r.outcome||r.status)}</button>`).join('')||`<div class="empty">${nt('No requests in this period.','所选时间段内没有请求。')}</div>`}</div><div class="notice"><strong>Access & limits</strong><span>Models: ${esc(k.scope)} · Protocols: ${esc((k.identity.scope_protocols||[]).join(', ')||'All')} · Expires: ${esc(k.identity.expires_at||'Never')} · ${esc(k.identity.rate_limit_rpm||'Unlimited')} RPM · Budget ${esc(k.identity.monthly_budget_usd||'Unlimited')}</span></div></div><div class="modal-foot api-key-detail-actions"><button class="btn" data-action="api-key-requests" data-id="${esc(k.id)}">View requests</button>${canReveal?`<button class="btn" data-action="reveal-key" data-id="${esc(k.id)}">Reveal</button><button class="btn" data-action="copy-stored-key" data-id="${esc(k.id)}">Copy</button>`:''}<button class="btn primary" data-action="close-overlay">Done</button></div></div></div>`}

function settingsRevisions(){
 const filters=state.auditFilters||{},keys=['actor','source','scope','status'];
 const rows=(state.revisions||[]).filter(r=>keys.every(k=>!filters[k]||r[k]===filters[k])&&(!filters.from||Date.parse(r.createdAt||r.time)>=Date.parse(filters.from))&&(!filters.to||Date.parse(r.createdAt||r.time)<Date.parse(filters.to)+86400000));
 return `<section class="card panel"><div class="section-head"><h2>Audit & Revisions</h2><span class="cell-sub">${rows.length} / ${state.revisions.length}</span></div><div class="toolbar wrap-actions">${keys.map(k=>`<label class="filter-field"><span>${({actor:'Actor',source:'Source',scope:'Resource',status:'Status'})[k]}</span><select class="select" data-action="audit-filter" data-field="${k}"><option value="">All</option>${[...new Set(state.revisions.map(r=>r[k]).filter(Boolean))].sort().map(v=>`<option value="${esc(v)}" ${filters[k]===v?'selected':''}>${esc(v)}</option>`).join('')}</select></label>`).join('')}${['from','to'].map(k=>`<label class="filter-field"><span>${k==='from'?'From':'To'}</span><input class="input" type="date" data-action="audit-filter" data-field="${k}" value="${esc(filters[k]||'')}"></label>`).join('')}</div><div class="table-wrap"><table class="table"><thead><tr>${['Revision','Time','Actor','Source','Resource','Result'].map(label=>`<th>${label}</th>`).join('')}</tr></thead><tbody>${rows.map(r=>`<tr class="clickable" tabindex="0" role="link" data-action="revision-detail" data-id="${esc(r.id)}"><td>#${esc(r.id)}<div class="cell-sub">${esc(r.summary)}</div></td><td>${esc(r.time)}</td><td>${esc(r.actor)}</td><td>${esc(r.source||'system')}</td><td>${esc(r.scope)}</td><td>${badge(r.status)}</td></tr>`).join('')||'<tr><td colspan="6">No matching revisions</td></tr>'}</tbody></table></div></section>`;
}

function billingUsageTable(rows, dimension) {
  if (!rows.length) return '<div class="empty">No requests recorded in this window.</div>';
  return `<div class="table-wrap billing-table-wrap"><table class="table billing-table"><thead><tr><th>${dimension}</th><th>Requests</th><th>Tokens</th><th>Recorded cost</th></tr></thead><tbody>${rows.map(row=>`<tr><td><strong>${esc(row.name)}</strong><small>${fmtCompact(row.failed)} failed · ${fmtCompact(row.canceled)} canceled</small></td><td>${fmtCompact(row.requests)}</td><td>${fmtCompact(row.tokens)}</td><td><span class="request-cost-pill">${esc(row.amount)}</span></td></tr>`).join('')}</tbody></table></div>`;
}

function settingsBilling(){
  const b=state.billing, points=(b.trend||[]).map(x=>Number(x.total_cost||0)), loading=state.usageLoading.billing;
  return `${settingsPricingSync()}<div class="page-head compact"><div><h2>Usage & Billing</h2><p>Costs are recorded estimates. Unobserved cost is shown as —; unknown prices do not imply free usage.</p></div><div class="head-actions"><select class="select" aria-label="Billing time window" data-action="billing-window" ${loading?'disabled':''}><option value="24h" ${state.billingWindow==='24h'?'selected':''}>24 hours</option><option value="168h" ${state.billingWindow==='168h'?'selected':''}>7 days</option><option value="720h" ${state.billingWindow==='720h'?'selected':''}>30 days</option></select><button class="btn" data-action="billing-export" ${loading||!b.reconciliation?'disabled':''}>Export reconciliation JSON</button>${loading?'<span role="status">Updating usage…</span>':''}</div></div>
    <div class="metrics"><div class="card metric"><div class="metric-label">Recorded Cost</div><div class="metric-value">${esc(b.totalCost)}</div><div class="metric-trend">${b.costObserved?sparkline(points):'No monetary cost observed'}</div></div><div class="card metric"><div class="metric-label">Requests</div><div class="metric-value">${esc(b.totalRequests)}</div><div class="metric-note">${b.recoveredRequests??'—'} recovered · ${b.failedRequests??'—'} failed · ${b.canceledRequests??'—'} canceled</div></div><div class="card metric"><div class="metric-label">Tokens</div><div class="metric-value">${esc(b.totalTokens)}</div></div><div class="card metric"><div class="metric-label">Avg / 1K Tokens</div><div class="metric-value">${esc(b.avgCost)}</div></div></div>
    <div class="billing-details"><section class="card panel"><h2>Provider detail</h2><p class="cell-sub">Requests without an upstream selection remain in the totals.</p>${billingUsageTable(b.providers,'Provider')}</section><section class="card panel"><h2>Model detail</h2>${billingUsageTable(b.models,'Logical model')}</section></div>
    <div class="notice"><strong>Reconciliation</strong><span>Export includes exact counts, token and cost dimensions, and UTC window boundaries. Cancellations are separate above and count as unsuccessful in client success rates. Costs cover recorded amounts only.</span></div>
    <div class="notice"><strong>Budgets and warnings</strong><span>Per-key monthly budgets are enforced against recorded cost. Missing prices can undercount budget consumption. Runtime quota/cooling and key spikes produce persistent in-app alerts.</span></div>`;
}

window.addEventListener('hashchange',event=>{if(typeof confirmDiscardEditor==='function'&&!confirmDiscardEditor()){history.replaceState(null,'',event.oldURL);return;}queueTargetLocation='';providerQuotaView='';state.mobileNav=false;state.insightsOpen=false;state.drawer=null;if(!state.modal?.busy)state.modal=null;if(restoreConsoleLocation()){reloadRequests();return;}render();});
if(!location.hash) location.hash='#/overview';
boot().then(()=>pollCodexUsageResets());
// Poll only the local intent journal; never dispatch upstream operations.
setInterval(()=>{void pollCodexUsageResets()},15000);
window.addEventListener('focus',()=>{void pollCodexUsageResets()});
